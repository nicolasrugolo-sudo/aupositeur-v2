{
  "name": "aupositeur-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "oauth:deploy": "wrangler deploy --config workers/decap-oauth/wrangler.jsonc",
    "oauth:secret:id": "wrangler secret put GITHUB_OAUTH_ID --config workers/decap-oauth/wrangler.jsonc",
    "oauth:secret:key": "wrangler secret put GITHUB_OAUTH_SECRET --config workers/decap-oauth/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  }
}
