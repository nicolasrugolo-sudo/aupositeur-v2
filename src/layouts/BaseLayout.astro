---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/settings/site.json';
import '../styles/global.css';
import '../styles/cart-header.css';
interface Props { title?: string; description?: string; }
const { title = site.defaultTitle, description = site.defaultDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang={site.locale}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content={site.themeColor} /><link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,