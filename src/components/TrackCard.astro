---
import ShareButton from './ShareButton.astro';
interface Track { title:string; descriptionCourte?:string; youtubeId?:string; audioKey?:string; spotifyUrl?:string; cover?:string; href?:string; }
interface Props { track:Track; index:number; kind:string; featured?:boolean; }
const { track,index,kind,featured=false }=Astro.props;
const mediaBase='https://aupositeur-media-api.nicolas-rugolo.workers.dev';
const youtubeId = (() => {
  const value = track.youtubeId?.trim();
  if (!value) return '';
  try {
    const url = new URL(value);
    if (url.hostname === 'youtu.be') return url.pathname.split('/').filter(Boolean)[0] || '';
    if (url.hostname.endsWith('youtube.com')) {
      if (url.pathname === '/watch') return url.searchParams.get('v') || '';
      const match = url.pathname.match(/^\/(?:shorts|embed|live)\/([^/?#]+)/);
      if (match) return match[1];
    }
  } catch {}
  return value;
})();
const youtubeUrl=youtubeId?`https://www.youtube.com/watch?v=${youtubeId}`:';
const audioUrl=track.audioKey?`${mediaBase}/media/${track.audioKey}`:'';
const visual=track.cover || (youtubeId?`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`:'');
const shareUrl=track.href?`https://www.aupositeur.be${track.href}`:(track.spotifyUrl||youtubeUrl||audioUrl||'https://www.aupositeur.be/musique/');
---
{featured ? (
<article class="featured-track" data-track>
  <div class="art">{visual?<img src={visual} alt={`Pochette — ${track.title}`} loading="eager"/>:<div class="art-fallback">A<span>.</span></div>}</div>
  <div class="featured-copy">
    <p class="eyebrow">À L'ÉCOUTE <i></i> {kind}</p>
    <h2>{track.href ? <a href={track.href}>{track.title}</a> : track.title}</h2>
    {track.descriptionCourte && <p class="description">{track.descriptionCourte}</p>}
    {audioUrl && <div class="player"><button class="play" type="button" aria-label={`Écouter ${track.title}`}>▶</button><div class="timeline"><input type="range" min="0" max="100" value="0" step="0.1" aria-label="Progression"/><div class="times"><span class="current">00:00</span><span class="duration">--:--</span></div></div><audio preload="metadata" src={audioUrl}></audio></div>}
    <div class="actions">{track.href&&<a href={track.href}>DÉCOUVRIR →</a>}{youtubeUrl&&<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">VOIR LA VIDÉO ↗</a>}{track.spotifyUrl&&<a href={track.spotifyUrl} target="_blank" rel="noopener noreferrer">SPOTIFY ↗</a>}<ShareButton title={track.title} text={`${track.title} — ${kind} par Aupositeur`} url={shareUrl} compact /></div>
  </div>
</article>
) : (
<article class="track-row" data-track>
  <button class="track-toggle" type="button" aria-expanded="false">
    <span class="number">{String(index+1).padStart(2,'0')}</span><span class="playmark">{audioUrl?'▶':'+'}</span><strong>{track.title}</strong><span class="kind">{kind}</span>
  </button>
  <div class="track-detail">
    {visual&&<img class="mini-cover" src={visual} alt={`Pochette — ${track.title}`} loading="lazy"/>}
    <div class="detail-copy">{track.descriptionCourte&&<p>{track.descriptionCourte}</p>}{audioUrl&&<div class="player"><button class="play" type="button" aria-label={`Écouter ${track.title}`}>▶</button><div class="timeline"><input type="range" min="0" max="100" value="0" step="0.1" aria-label="Progression"/><div class="times"><span class="current">00:00</span><span class="duration">--:--</span></div></div><audio preload="metadata" src={audioUrl}></audio></div>}<div class="actions">{track.href&&<a href={track.href}>DÉCOUVRIR →</a>}{youtubeUrl&&<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">VOIR LA VIDÉO ↗</a>}{track.spotifyUrl&&<a href={track.spotifyUrl} target="_blank" rel="noopener noreferrer">SPOTIFY ↗</a>}<ShareButton title={track.title} text={`${track.title} — ${kind} par Aupositeur`} url={shareUrl} compact /></div></div>
  </div>
</article>
)}
<script>
const fmt = (s: number) => {
  if (!Number.isFinite(s)) return '--:--';
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60);
  return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
};

document.querySelectorAll<HTMLElement>('[data-track]').forEach((root) => {
  const toggle = root.querySelector<HTMLButtonElement>('.track-toggle');
  const audio = root.querySelector<HTMLAudioElement>('audio');
  const play = root.querySelector<HTMLButtonElement>('.play');
  const range = root.querySelector<HTMLInputElement>('input[type="range"]');
  const current = root.querySelector<HTMLElement>('.current');
  const duration = root.querySelector<HTMLElement>('.duration');

  if (toggle) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('.track-toggle[aria-expanded="true"]').forEach((button) => {
        if (button !== toggle) button.setAttribute('aria-expanded', 'false');
      });
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }

  if (!audio || !play) return;

  audio.addEventListener('loadedmetadata', () => {
    if (duration) duration.textContent = fmt(audio.duration);
  });

  audio.addEventListener('timeupdate', () => {
    if (range && audio.duration) range.value = String((audio.currentTime / audio.duration) * 100);
    if (current) current.textContent = fmt(audio.currentTime);
  });

  audio.addEventListener('play', () => {
    document.querySelectorAll<HTMLAudioElement>('audio').forEach((otherAudio) => {
      if (otherAudio !== audio) otherAudio.pause();
    });
    play.textContent = '❚❚';
    root.classList.add('is-playing');
  });

  audio.addEventListener('pause', () => {
    play.textContent = '▶';
    root.classList.remove('is-playing');
  });

  play.addEventListener('click', () => {
    if (audio.paused) void audio.play();
    else audio.pause();
  });

  range?.addEventListener('input', () => {
    if (audio.duration) audio.currentTime = (Number(range.value) / 100) * audio.duration;
  });
});
</script>
<style>
:global(.track-list) .track-row{border-bottom:1px solid rgba(255,255,255,.2)}
.track-toggle{width:100%;min-height:78px;display:grid;grid-template-columns:3rem 2rem minmax(0,1fr) auto;gap:1rem;align-items:center;padding:0;background:none;border:0;color:inherit;text-align:left;cursor:pointer}
.number{font:600 .7rem/1 var(--mono,monospace);color:rgba(241,237,228,.42);letter-spacing:.1em}
.playmark{color:transparent;transition:.2s}
.track-toggle strong{font-family:var(--serif,Georgia,serif);font-size:clamp(1.12rem,1.65vw,1.48rem);font-weight:400;line-height:1.25;letter-spacing:-.025em}
.kind{font:.6rem/1 var(--mono,monospace);text-transform:uppercase;letter-spacing:.12em;color:rgba(241,237,228,.38)}
.track-row:hover .number,.track-row.is-playing .number,.track-row:hover .playmark,.track-row.is-playing .playmark{color:var(--ap-rust-bright,#d0653d)}
.track-detail{display:grid;grid-template-columns:minmax(130px,220px) 1fr;gap:clamp(1.5rem,4vw,4rem);max-height:0;overflow:hidden;opacity:0;transition:max-height .45s ease,opacity .3s ease,padding .45s ease}
.track-toggle[aria-expanded="true"]+.track-detail{max-height:700px;opacity:1;padding:1rem 0 3rem}
.mini-cover{width:100%;aspect-ratio:1;object-fit:cover}
.detail-copy>p,.description{max-width:42rem;font-family:var(--mono,monospace);color:rgba(241,237,228,.68);line-height:1.65}
.featured-track{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:clamp(3rem,8vw,9rem);align-items:center}
.art{aspect-ratio:1;background:#111;overflow:hidden}.art img{width:100%;height:100%;object-fit:cover}
.art-fallback{height:100%;display:grid;place-items:center;font-family:var(--serif,Georgia,serif);font-size:clamp(5rem,12vw,10rem);font-weight:400}.art-fallback span{color:var(--ap-rust-bright,#d0653d)}
.eyebrow{font:.65rem/1 var(--mono,monospace);letter-spacing:.13em;text-transform:uppercase;color:rgba(241,237,228,.58)}
.eyebrow i{display:inline-block;width:20px;border-top:1px solid var(--ap-rust-bright,#d0653d);vertical-align:middle;margin:0 .6rem}
.featured-copy h2{font-family:var(--serif,Georgia,serif);font-size:clamp(2.7rem,5.6vw,6.2rem);font-weight:400;line-height:.98;letter-spacing:-.045em;margin:1.5rem 0 2rem;overflow-wrap:anywhere;text-wrap:balance}
.player{display:flex;align-items:center;gap:1.3rem;margin:2.3rem 0}
.play{flex:0 0 48px;width:48px;height:48px;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:transparent;color:var(--ap-rust-bright,#d0653d);cursor:pointer}
.timeline{flex:1}.timeline input{width:100%;accent-color:var(--ap-rust-bright,#d0653d)}
.times{display:flex;justify-content:space-between;margin-top:.35rem;font:.6rem/1 var(--mono,monospace);color:rgba(241,237,228,.45)}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.1rem 1.6rem;margin-top:2rem}.actions>a{font:.62rem/1 var(--mono,monospace);letter-spacing:.1em;border-bottom:1px solid currentColor;padding-bottom:.45rem}
@media(max-width:760px){.featured-track{grid-template-columns:1fr;gap:2.3rem}.featured-copy h2{font-size:clamp(2.4rem,11.5vw,4.2rem)}.track-toggle{min-height:64px;grid-template-columns:2.2rem 1.4rem minmax(0,1fr);gap:.6rem}.track-toggle strong{font-size:1.08rem}.kind{display:none}.track-detail{grid-template-columns:1fr}.track-toggle[aria-expanded="true"]+.track-detail{padding:.8rem 0 2.5rem}.mini-cover{max-width:180px}.player{margin:1.7rem 0}}
</style>
