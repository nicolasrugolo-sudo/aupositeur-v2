---
interface Props {
  title: string;
  body?: string;
  url: string;
  photo?: string;
  slug: string;
  compact?: boolean;
}

const {
  title,
  body = '',
  url,
  photo = '/images/aupositeur/portraits/aupositeur-01.png',
  slug,
  compact = false,
} = Astro.props;

const plainPoem = body
  .replace(/^---[\s\S]*?---\s*/u, '')
  .replace(/<!--([\s\S]*?)-->/g, '')
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/^>\s?/gm, '')
  .replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/__([^_]+)__/g, '$1')
  .replace(/\*([^*]+)\*/g, '$1')
  .replace(/_([^_]+)_/g, '$1')
  .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
  .replace(/<br\s*\/?>/gi, '\n')
  .replace(/<[^>]+>/g, '')
  .replace(/\r/g, '')
  .replace(/\n{3,}/g, '\n\n')
  .trim();

// Keep the canonical URL separate from the publication so it is never duplicated.
const publication = `${title.toUpperCase()}\n\n${plainPoem}\n\n— AUPOSITEUR`;
const copyPublication = `${publication}\n\n${url}`;

// Pinterest's official Save flow accepts a destination URL, a public image URL
// and a description up to 500 characters. Use it instead of the generic OS share
// sheet so the Pin keeps its destination and poem text.
const pinterestDescriptionSource = `${title.toUpperCase()}\n\n${plainPoem}\n\n— AUPOSITEUR`;
const pinterestDescription = pinterestDescriptionSource.length > 500
  ? `${pinterestDescriptionSource.slice(0, 497).trimEnd()}…`
  : pinterestDescriptionSource;
const pinterestMedia = new URL(photo, Astro.site).href;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(copyPublication)}`;
---

<div
  class:list={['ap-poem-share', { compact }]}
  data-poem-share-root
  data-copy={copyPublication}
>
  <button
    type="button"
    class="share-main"
    data-share-poem
    data-title={title}
    data-text={publication}
    data-url={url}
    data-photo={photo}
    data-slug={slug}
  >
    <span>Partager</span><i aria-hidden="true">↗</i>
  </button>

  <div class="ap-poem-share__networks" aria-label="Partager sur un réseau social">
    <button
      type="button"
      data-share-pinterest
      data-pin-url={url}
      data-pin-media={pinterestMedia}
      data-pin-description={pinterestDescription}
    >Pinterest</button>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <button type="button" data-copy-poem>Copier texte + lien</button>
  </div>

  <span class="share-status" data-share-status aria-live="polite"></span>
</div>

<style>
  .ap-poem-share__networks {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .8rem;
    margin-top: .55rem;
    font-size: .78rem;
  }

  .ap-poem-share__networks a,
  .ap-poem-share__networks button {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: .18em;
    cursor: pointer;
    opacity: .76;
  }

  .ap-poem-share__networks a:hover,
  .ap-poem-share__networks button:hover,
  .ap-poem-share__networks a:focus-visible,
  .ap-poem-share__networks button:focus-visible {
    opacity: 1;
  }
</style>

<script is:inline>
  (() => {
    if (window.__aupositeurPoemShareReady) return;
    window.__aupositeurPoemShareReady = true;

    const W = 1080;
    const H = 1350;
    const ivory = '#f1ede4';
    const rust = '#b95632';
    const black = '#080808';
    const serif = '"Libre Baskerville", Georgia, serif';
    const mono = '"Courier Prime", "Courier New", monospace';

    function wrap(ctx, text, maxWidth) {
      const words = text.trim().split(/\s+/);
      const lines = [];
      let line = '';
      for (const word of words) {
        const test = line ? `${line} ${word}` : word;
        if (ctx.measureText(test).width > maxWidth && line) {
          lines.push(line);
          line = word;
        } else {
          line = test;
        }
      }
      if (line) lines.push(line);
      return lines;
    }

    function fitTitle(ctx, text, maxWidth, maxLines = 3) {
      let size = 92;
      while (size >= 54) {
        ctx.font = `400 ${size}px ${serif}`;
        const lines = wrap(ctx, text.toUpperCase(), maxWidth);
        if (lines.length <= maxLines) return { size, lines };
        size -= 2;
      }
      ctx.font = `400 54px ${serif}`;
      return { size: 54, lines: wrap(ctx, text.toUpperCase(), maxWidth).slice(0, maxLines) };
    }

    function coverImage(ctx, img, x, y, width, height) {
      const scale = Math.max(width / img.naturalWidth, height / img.naturalHeight);
      const sw = width / scale;
      const sh = height / scale;
      const sx = (img.naturalWidth - sw) / 2;
      const sy = (img.naturalHeight - sh) / 2;
      ctx.drawImage(img, sx, sy, sw, sh, x, y, width, height);
    }

    async function loadImage(src) {
      const img = new Image();
      img.decoding = 'async';
      img.src = src;
      await img.decode();
      return img;
    }

    async function drawCard(title, photo) {
      const canvas = document.createElement('canvas');
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('canvas');

      ctx.fillStyle = black;
      ctx.fillRect(0, 0, W, H);

      const img = await loadImage(photo);
      coverImage(ctx, img, 0, 0, W, 790);

      const shade = ctx.createLinearGradient(0, 0, 0, 830);
      shade.addColorStop(0, 'rgba(8,8,8,.08)');
      shade.addColorStop(.55, 'rgba(8,8,8,.16)');
      shade.addColorStop(1, 'rgba(8,8,8,1)');
      ctx.fillStyle = shade;
      ctx.fillRect(0, 0, W, 840);

      const side = ctx.createLinearGradient(0, 0, W, 0);
      side.addColorStop(0, 'rgba(8,8,8,.9)');
      side.addColorStop(.42, 'rgba(8,8,8,.2)');
      side.addColorStop(1, 'rgba(8,8,8,.02)');
      ctx.fillStyle = side;
      ctx.fillRect(0, 0, W, 790);

      ctx.fillStyle = 'rgba(241,237,228,.78)';
      ctx.font = `400 23px ${mono}`;
      ctx.fillText('POÈME', 82, 100);

      const { size, lines } = fitTitle(ctx, title, 820, 3);
      const lineHeight = size * 1.08;
      let y = 875;
      ctx.font = `400 ${size}px ${serif}`;
      ctx.fillStyle = ivory;
      for (const line of lines) {
        ctx.fillText(line, 82, y);
        y += lineHeight;
      }

      ctx.fillStyle = rust;
      ctx.fillRect(82, y + 18, 72, 4);

      const signature = 'A U P O S I T E U R';
      ctx.fillStyle = ivory;
      ctx.font = `400 26px ${serif}`;
      ctx.fillText(signature, 82, 1260);
      const sw = ctx.measureText(signature).width;
      ctx.fillStyle = rust;
      ctx.beginPath();
      ctx.arc(82 + sw + 14, 1252, 5, 0, Math.PI * 2);
      ctx.fill();

      const site = 'aupositeur.be';
      ctx.fillStyle = 'rgba(241,237,228,.72)';
      ctx.font = `400 22px ${mono}`;
      ctx.fillText(site, W - 82 - ctx.measureText(site).width, 1260);

      return canvas;
    }

    const toBlob = (canvas) => new Promise((resolve) => canvas.toBlob(resolve, 'image/png', .96));

    async function copyCaption(root, status) {
      try {
        await navigator.clipboard.writeText(root?.dataset.copy || '');
        if (status) status.textContent = 'Texte et lien copiés.';
        return true;
      } catch {
        if (status) status.textContent = 'Copie automatique indisponible.';
        return false;
      }
    }

    function loadPinterest() {
      if (window.PinUtils?.pinOne) return Promise.resolve(window.PinUtils);
      if (window.__aupositeurPinterestPromise) return window.__aupositeurPinterestPromise;

      window.__aupositeurPinterestPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-aupositeur-pinterest]');
        if (existing) {
          const wait = () => {
            if (window.PinUtils?.pinOne) resolve(window.PinUtils);
            else setTimeout(wait, 60);
          };
          wait();
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://assets.pinterest.com/js/pinit.js';
        script.async = true;
        script.defer = true;
        script.dataset.aupositeurPinterest = 'true';
        script.onload = () => {
          let attempts = 0;
          const wait = () => {
            if (window.PinUtils?.pinOne) {
              resolve(window.PinUtils);
              return;
            }
            attempts += 1;
            if (attempts > 80) {
              reject(new Error('Pinterest indisponible'));
              return;
            }
            setTimeout(wait, 50);
          };
          wait();
        };
        script.onerror = () => reject(new Error('Pinterest indisponible'));
        document.head.appendChild(script);
      });

      return window.__aupositeurPinterestPromise;
    }

    document.addEventListener('click', async (event) => {
      const pinterestButton = event.target.closest?.('[data-share-pinterest]');
      if (pinterestButton) {
        const root = pinterestButton.closest('[data-poem-share-root]');
        const status = root?.querySelector('[data-share-status]');
        try {
          if (status) status.textContent = 'Ouverture de Pinterest…';
          const PinUtils = await loadPinterest();
          PinUtils.pinOne({
            url: pinterestButton.dataset.pinUrl,
            media: pinterestButton.dataset.pinMedia,
            description: pinterestButton.dataset.pinDescription,
          });
          if (status) status.textContent = 'Pinterest prêt avec le texte et le lien.';
        } catch {
          await copyCaption(root, status);
          window.open('https://www.pinterest.com/pin/create/button/', '_blank', 'noopener,noreferrer');
        }
        setTimeout(() => { if (status) status.textContent = ''; }, 3000);
        return;
      }

      const copyButton = event.target.closest?.('[data-copy-poem]');
      if (copyButton) {
        const root = copyButton.closest('[data-poem-share-root]');
        const status = root?.querySelector('[data-share-status]');
        await copyCaption(root, status);
        setTimeout(() => { if (status) status.textContent = ''; }, 2500);
        return;
      }

      const button = event.target.closest?.('[data-share-poem]');
      if (!button) return;

      const root = button.closest('[data-poem-share-root]');
      const status = root?.querySelector('[data-share-status]');

      try {
        if (status) status.textContent = 'Création de l’image…';
        await document.fonts?.load('400 92px "Libre Baskerville"');
        await document.fonts?.load('400 22px "Courier Prime"');
        await document.fonts?.ready;

        const title = button.dataset.title || 'Poème';
        const photo = button.dataset.photo || '/images/aupositeur/portraits/aupositeur-01.png';
        const slug = button.dataset.slug || 'poeme';
        const publication = button.dataset.text || '';
        const url = button.dataset.url || window.location.href;
        const copyPublication = `${publication}\n\n${url}`;

        const canvas = await drawCard(title, photo);
        const blob = await toBlob(canvas);
        if (!blob) throw new Error('blob');

        const file = new File([blob], `aupositeur-${slug}.png`, { type: 'image/png' });

        try { await navigator.clipboard.writeText(copyPublication); } catch {}

        if (navigator.share && (!navigator.canShare || navigator.canShare({ files: [file] }))) {
          try {
            await navigator.share({
              files: [file],
              title: `${title} — AUPOSITEUR`,
              text: publication,
              url,
            });
            if (status) status.textContent = 'Image partagée · texte et lien copiés si nécessaire.';
            setTimeout(() => { if (status) status.textContent = ''; }, 3000);
            return;
          } catch (error) {
            if (error?.name === 'AbortError') {
              if (status) status.textContent = '';
              return;
            }

            try {
              await navigator.share({ files: [file], title: `${title} — AUPOSITEUR` });
              if (status) status.textContent = 'Image partagée · texte et lien copiés.';
              setTimeout(() => { if (status) status.textContent = ''; }, 3000);
              return;
            } catch (fallbackError) {
              if (fallbackError?.name === 'AbortError') {
                if (status) status.textContent = '';
                return;
              }
            }
          }
        }

        const objectUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = objectUrl;
        a.download = file.name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(objectUrl), 1500);
        if (status) status.textContent = 'Image enregistrée · texte et lien copiés.';
      } catch (error) {
        if (error?.name === 'AbortError') {
          if (status) status.textContent = '';
          return;
        }
        if (status) status.textContent = 'Partage indisponible.';
      }
      setTimeout(() => { if (status) status.textContent = ''; }, 3000);
    });
  })();
</script>
