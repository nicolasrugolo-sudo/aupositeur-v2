---
interface Props { title: string; text?: string; url?: string; compact?: boolean; mediaUrl?: string; author?: string; }
const { title, text = `Découvrez « ${title} » sur Aupositeur.`, url = new URL(Astro.url.pathname, Astro.site).href, compact = false, mediaUrl, author = 'Aupositeur' } = Astro.props;
const publication = `${text}\n\n— ${author}\n\n${url}`;
const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(publication);
const mediaName = mediaUrl?.split('/').pop()?.split('?')[0] || 'aupositeur.mp4';
---
<div class:list={['share-work', { compact }]} data-share-root data-title={title} data-text={text} data-publication={publication} data-url={url} data-media-url={mediaUrl} data-media-name={mediaName}>
  <button class="share-main" type="button" data-share-native aria-expanded="false"><span>Partager</span><i aria-hidden="true">↗</i></button>
  <div class="share-options" data-share-options>
    {mediaUrl && <button type="button" data-share-media>Partager la vidéo</button>}
    {mediaUrl && <a href={mediaUrl} download={mediaName}>Télécharger la vidéo</a>}
    <button type="button" data-copy-publication>Copier la publication</button>
    {mediaUrl ? <button type="button" data-prepare-facebook>Préparer pour Facebook</button> : <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer">Facebook</a>}
    <a href={`https://wa.me/?text=${encodedText}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <a href={`mailto:?subject=${encodeURIComponent(title + ' — Aupositeur')}&body=${encodedText}`}>E-mail</a>
    <button type="button" data-copy-link>Copier le lien</button>
  </div>
  <span class="share-status" data-share-status aria-live="polite"></span>
</div>
<script>
  import '../scripts/share.ts';
</script>


