---
interface Props { type: 'ecrits'|'reflexions'|'musiques'|'citations'; contentId: string; }
const {type,contentId}=Astro.props;
---
<section class="aup-comments" data-community-comments data-type={type} data-id={contentId} data-api={import.meta.env.PUBLIC_COMMUNITY_API_URL || ""} data-turnstile-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ""} aria-label="Commentaires des lecteurs">
  <h2>Les mots des lecteurs</h2>
  <p>Un texte vous a touché ? Laissez quelques mots. Ils seront publiés après validation.</p>
  <div class="aup-comments-list" aria-live="polite"></div>
  <form class="aup-comments-form">
    <label>Votre nom ou pseudonyme <input name="name" required minlength="2" maxlength="80" autocomplete="nickname" /></label>
    <label>Votre message <textarea name="body" required minlength="3" maxlength="3000" rows="5"></textarea></label>
    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ""}></div>
    <button type="submit">Envoyer mon commentaire</button>
    <p class="aup-comments-status" role="status"></p>
  </form>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>

  document.querySelectorAll<HTMLElement>('[data-community-comments]').forEach(async section=>{
    const type=section.dataset.type,id=section.dataset.id,API=section.dataset.api;
    const list=section.querySelector<HTMLElement>('.aup-comments-list')!;
    const form=section.querySelector<HTMLFormElement>('form')!;
    const status=section.querySelector<HTMLElement>('.aup-comments-status')!;
    if(!API||!section.dataset.turnstileKey){form.hidden=true;status.textContent='Les commentaires seront bientôt disponibles.';return;}
    const load=async()=>{
      try{
        const r=await fetch(API+'/api/comments?type='+encodeURIComponent(type!)+'&id='+encodeURIComponent(id!));
        if(!r.ok)throw Error();
        const data=await r.json();list.replaceChildren();
        if(data.enabled===false){form.hidden=true;const note=document.createElement('p');note.textContent='Les commentaires sont fermés pour cette publication.';list.append(note);}
        for(const c of data.comments){
          const item=document.createElement('article'),name=document.createElement('strong'),msg=document.createElement('p');
          name.textContent=c.author_name+(c.is_author_reply?' · AUPOSITEUR':'');
          msg.textContent=c.body;item.append(name,msg);list.append(item);
        }
      }catch{list.textContent='Impossible de charger les commentaires pour le moment.';}
    };
    await load();
    form.addEventListener('submit',async e=>{
      e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;status.textContent='Envoi en cours…';
      const fd=new FormData(form);
      try{
        const r=await fetch(API+'/api/comments',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({type,id,name:fd.get('name'),body:fd.get('body'),turnstile:fd.get('cf-turnstile-response')})});
        const data=await r.json();if(!r.ok)throw Error(data.error||'Envoi impossible');
        status.textContent='Merci. Votre message attend maintenant une validation.';form.reset();
        (window as any).turnstile?.reset();
      }catch(err){status.textContent=err instanceof Error?err.message:'Envoi impossible';}
      finally{button.disabled=false;}
    });
  });
</script>
<style>
.aup-comments{max-width:760px;margin:4rem auto;padding:2rem 1rem;border-top:1px solid currentColor}
.aup-comments h2{font-family:Georgia,serif;font-size:clamp(1.5rem,3vw,2.3rem);font-weight:normal}
.aup-comments p{line-height:1.6}.aup-comments-list article{padding:1rem 0;border-bottom:1px solid #ccc}
.aup-comments-list strong{font-size:.9rem}.aup-comments-form{display:grid;gap:1rem;margin-top:2rem}
.aup-comments-form label{display:grid;gap:.4rem}.aup-comments-form input,.aup-comments-form textarea{width:100%;padding:.8rem;border:1px solid #999;background:transparent;color:inherit;font:inherit}
.aup-comments-form button{justify-self:start;padding:.8rem 1.4rem;background:#222;color:white;border:0;cursor:pointer}
.aup-comments-form button:disabled{opacity:.5}
</style>
