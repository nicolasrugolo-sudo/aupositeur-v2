---
interface Props { type: 'ecrits'|'reflexions'|'musiques'|'citations'; contentId: string; }
const {type,contentId}=Astro.props;
const formId = `aup-comment-form-${type}-${contentId.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---
<section data-pagefind-ignore class="aup-comments" data-community-comments data-type={type} data-id={contentId} data-api={import.meta.env.PUBLIC_COMMUNITY_API_URL || "https://community-api.aupositeur.be"} data-turnstile-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAGDeReG_cH6DKjRS"} aria-label="Commentaires des lecteurs">
  <header class="aup-comments-heading">
    <div><span class="aup-comments-eyebrow">APRÈS LA LECTURE</span><h2>Les mots des lecteurs</h2><p class="aup-comments-intro">Parce qu’un texte peut continuer de vivre dans le regard de celui qui le lit.</p></div>
    <span class="aup-comments-count" aria-live="polite"></span>
  </header>
  <div class="aup-comments-list" aria-live="polite"><p class="aup-comments-loading">Chargement des contributions…</p></div>
  <div class="aup-comments-compose">
    <button class="aup-comments-toggle" type="button" aria-expanded="false" aria-controls={formId}>Laisser un commentaire <span aria-hidden="true">↗</span></button>
    <form class="aup-comments-form" id={formId} method="post" hidden>
      <h3>Votre mot</h3>
      <p class="aup-comments-hint">Un prénom, un pseudonyme et quelques lignes. Votre message sera publié après modération.</p>
    <label>Votre nom ou pseudonyme <input name="name" required minlength="2" maxlength="80" autocomplete="nickname" /></label>
    <label>Votre message <textarea name="body" required minlength="3" maxlength="3000" rows="5"></textarea></label>
    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAGDeReG_cH6DKjRS"}></div>
    <button type="submit">Envoyer mon commentaire</button>
    <p class="aup-comments-status" role="status"></p>
    </form>
  </div>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(() => {
  function init() {
    document.querySelectorAll('[data-community-comments]').forEach(section => {
      if (section.dataset.initialized) return;
      section.dataset.initialized = '1';
      const form = section.querySelector('form');
      const status = section.querySelector('.aup-comments-status');
      const list = section.querySelector('.aup-comments-list');
      const count = section.querySelector('.aup-comments-count');
      const toggle = section.querySelector('.aup-comments-toggle');
      const compose = section.querySelector('.aup-comments-compose');
      toggle.addEventListener('click', () => {
        const opening = form.hidden;
        form.hidden = !opening;
        toggle.setAttribute('aria-expanded', String(opening));
        toggle.firstChild.textContent = opening ? 'Fermer le formulaire ' : 'Laisser un commentaire ';
        if (opening) form.querySelector('input[name="name"]').focus();
      });
      const api = (section.dataset.api || '').replace(/\/$/, '');
      const key = section.dataset.turnstileKey || '';
      const type = section.dataset.type;
      const id = section.dataset.id;

      // Always intercept submit, even when configuration or loading fails.
      form.addEventListener('submit', async event => {
        event.preventDefault();
        if (!api || !key) {
          status.textContent = 'Commentaires indisponibles : configuration manquante.';
          return;
        }
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        status.textContent = 'Envoi en cours…';
        try {
          const data = new FormData(form);
          const token = data.get('cf-turnstile-response');
          if (!token) throw new Error('Veuillez terminer la vérification anti-robot.');
          const response = await fetch(api + '/api/comments', {
            method: 'POST',
            headers: {'content-type': 'application/json'},
            body: JSON.stringify({type, id, name: data.get('name'), body: data.get('body'), turnstile: token})
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Envoi impossible');
          status.textContent = 'Merci. Votre commentaire a été reçu et attend une validation.';
          form.reset();
          window.turnstile?.reset();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Impossible d’envoyer le commentaire.';
        } finally {
          button.disabled = false;
        }
      });

      if (!api || !key) {
        compose.hidden = true;
        list.textContent = !key ? 'Commentaires en préparation : clé publique Turnstile absente de cette version du site.' : 'Commentaires indisponibles : adresse de l’API manquante.';
        return;
      }
      fetch(api + '/api/comments?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(id))
        .then(async response => {
          if (!response.ok) throw new Error('Chargement indisponible');
          return response.json();
        })
        .then(data => {
          list.replaceChildren();
          if (data.enabled === false) {
            compose.hidden = true;
            list.textContent = 'Les commentaires sont fermés pour cette publication.';
            return;
          }
          const comments = data.comments || [];
          count.textContent = comments.length ? comments.length + (comments.length === 1 ? ' contribution' : ' contributions') : '';
          if (!comments.length) {
            const empty = document.createElement('p');
            empty.className = 'aup-comments-empty';
            empty.textContent = 'Aucun mot pour le moment. Le premier sera peut-être le vôtre.';
            list.append(empty);
          }
          const threads = new Map();
          for (const comment of comments) {
            const article = document.createElement('article');
            const author = document.createElement('strong');
            const body = document.createElement('p');
            const byline = document.createElement('div');
            byline.className = 'aup-comments-byline';
            if (comment.is_author_reply) article.classList.add('aup-comments-author-reply');
            author.textContent = comment.author_name;
            byline.append(author);
            if (comment.is_author_reply) {
              const mark = document.createElement('span');
              mark.textContent = 'Réponse de l’auteur';
              byline.append(mark);
            }
            body.textContent = comment.body;
            article.append(byline, body);
            const children = document.createElement('div');
            children.className = 'aup-comment-replies';
            threads.set(comment.id,{article,children});
            article.append(children);
          }
          for (const comment of comments) {
            const entry = threads.get(comment.id);
            const parent = comment.parent_id && comment.parent_id !== comment.id && threads.get(comment.parent_id);
            (parent ? parent.children : list).append(entry.article);
          }
        })
        .catch(() => { list.textContent = 'Impossible de charger les commentaires pour le moment.'; });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, {once: true});
  else init();
})();
</script>
<style>
.aup-comments-heading{display:flex;align-items:start;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.aup-comments-intro{max-width:42ch;color:#535353}
.aup-comments-eyebrow,.aup-comments-count{font-size:.75rem;letter-spacing:.09em}
.aup-comments-byline{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem}
.aup-comments-byline span{font-size:.75rem;border:1px solid currentColor;border-radius:1rem;padding:.12rem .5rem}
.aup-comments-list article p{white-space:pre-wrap;overflow-wrap:anywhere}
.aup-comments .aup-comment-replies:not(:empty){margin-block:.8rem .2rem;margin-inline-start:clamp(.35rem,2vw,1rem);padding-inline-start:clamp(.55rem,2vw,1rem);border-inline-start:1px solid #8f8a83}
.aup-comment-replies .aup-comment-replies{margin-inline-start:0}
.aup-comments .aup-comments-author-reply{border-inline-start:2px solid currentColor;padding-inline-start:.85rem}
.aup-comments-empty{background:#f4f0e9;color:#34302c;padding:1.15rem;border-inline-start:2px solid #26221e}
.aup-comments{max-width:760px;margin:4rem auto;padding:2rem 1rem;border-top:1px solid #d5d5d5;color:inherit}
.aup-comments h2{font-family:var(--ap-serif,Georgia,serif);font-size:clamp(1.5rem,3vw,2.3rem);font-weight:normal}
.aup-comments p{line-height:1.6}
.aup-comments-list article{padding:1rem 0;border-bottom:1px solid #d5d5d5}
.aup-comments-list strong{font-size:.9rem}
.aup-comments-compose{margin-top:1.5rem}
.aup-comments .aup-comments-toggle,
.aup-comments .aup-comments-form button[type="submit"]{
  appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:.45rem;
  min-height:44px;width:max-content;max-width:100%;padding:.8rem 1.35rem;
  border:1px solid #111;border-radius:999px;background:#111;color:#fff;
  font-family:inherit;font-size:.85rem;font-weight:700;line-height:1.3;
  letter-spacing:0;text-transform:none;text-decoration:none;cursor:pointer;
  transition:background-color .2s,border-color .2s,color .2s;
}
.aup-comments .aup-comments-toggle:is(:hover,:focus-visible),
.aup-comments .aup-comments-form button[type="submit"]:is(:hover,:focus-visible):not(:disabled){
  background:var(--ap-button-accent,#d0653d);border-color:var(--ap-button-accent,#d0653d);color:#fff;
}
.aup-comments .aup-comments-toggle:focus-visible,
.aup-comments .aup-comments-form button[type="submit"]:focus-visible{
  outline:2px solid var(--ap-button-accent,#d0653d);outline-offset:3px;
}
.aup-comments-form:not([hidden]){display:grid;gap:1rem;margin-top:1.5rem}
.aup-comments-form[hidden]{display:none!important}
.aup-comments-form label{display:grid;gap:.4rem}
.aup-comments-form input,.aup-comments-form textarea{
  box-sizing:border-box;width:100%;padding:.8rem;border:1px solid #999;
  border-radius:4px;background:transparent;color:inherit;font:inherit;
}
.aup-comments-form :is(input,textarea):focus-visible{outline:2px solid var(--ap-button-accent,#d0653d);outline-offset:2px}
.aup-comments .aup-comments-form button[type="submit"]:disabled{opacity:.5;cursor:wait}
.aup-comments-status:not(:empty){padding:.75rem 0}
@media(prefers-reduced-motion:reduce){.aup-comments .aup-comments-toggle,.aup-comments .aup-comments-form button[type="submit"]{transition:none}}
</style>
