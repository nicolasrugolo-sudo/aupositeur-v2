---
import {getCollection} from 'astro:content';
interface Props { ids:string[]; exclude:string; max?:number; }
const {ids,exclude,max=4}=Astro.props;
const tax=await getCollection('categories');const names=Object.fromEntries(tax.map(x=>[x.id,x.data.label]));
const [poems,quotes,music,thoughts]=await Promise.all([getCollection('poemes'),getCollection('citations'),getCollection('musiques'),getCollection('reflexions')]);
const works=[...poems.filter(x=>!x.data.draft).map(x=>({key:'ecrits/'+x.id,href:'/ecrits/'+x.id+'/',title:x.data.title,kind:'Écrit',ids:x.data.categories})),...quotes.filter(x=>!x.data.draft).map(x=>({key:'citations/'+x.id,href:'/citations/'+x.id+'/',title:x.data.text,kind:'Citation',ids:x.data.categories})),...music.filter(x=>!x.data.draft).map(x=>({key:'musique/'+x.id,href:'/musique/'+x.id+'/',title:x.data.title,kind:'Musique',ids:x.data.categories})),...thoughts.filter(x=>!x.data.draft).map(x=>({key:'reflexions/'+x.id,href:'/reflexions/'+x.id+'/',title:x.data.title,kind:'Réflexion',ids:x.data.categories.length?x.data.categories:x.data.category?[x.data.category]:[]}))];
const related=works.filter(x=>x.key!==exclude&&x.ids.some(id=>ids.includes(id))).map(x=>({...x,score:x.ids.filter(id=>ids.includes(id)).length})).sort((a,b)=>b.score-a.score||a.title.localeCompare(b.title,'fr')).slice(0,max);
---
{ids.length>0&&<aside class="ap-related" aria-label="Explorer les mêmes thèmes"><p class="ap-related__label">Explorer les thèmes</p><div class="ap-related__tags">{ids.filter(id=>names[id]).map(id=><a href={`/themes/${id}/`}>{names[id]}</a>)}</div>{related.length>0&&<><h2>Dans le même esprit</h2><ul>{related.map(item=><li><span>{item.kind}</span><a href={item.href}>{item.title}</a></li>)}</ul></>}</aside>}
<style>.ap-related{margin:3rem 0;padding:2rem 0;border-block:1px solid rgba(241,237,228,.25);color:var(--ap-ivory,#f1ede4)}.ap-related__label,.ap-related li span{font:.7rem/1.5 var(--mono,monospace);opacity:.65;letter-spacing:.08em;text-transform:uppercase}.ap-related__tags{display:flex;flex-wrap:wrap;gap:.65rem;margin:1rem 0 2rem}.ap-related__tags a{border:1px solid currentColor;border-radius:3rem;padding:.45rem .8rem;font:.8rem/1.4 var(--mono,monospace)}.ap-related h2{font:400 clamp(1.5rem,3vw,2.3rem)/1.2 var(--serif,Georgia,serif)}.ap-related ul{padding:0;list-style:none}.ap-related li{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(241,237,228,.15)}.ap-related li a{overflow-wrap:anywhere}</style>
