---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/ecrits/', label: 'Écrits' },
  { href: '/musiques/', label: 'Musiques' },
  { href: '/livres/', label: 'Livres' },
  { href: '/citations/', label: 'Citations' },
  { href: '/boutique/', label: 'Boutique' },
  { href: '/a-propos/', label: 'À propos' },
];

const isCurrent = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname.startsWith(href);
---

<header class="ap-header" data-site-header>
  <a
    class="ap-brand"
    href="/"
    aria-label="Aupositeur, accueil"
  >
    <span>Aupositeur</span>
    <i aria-hidden="true"></i>
  </a>

  <button
    class="ap-menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
    aria-label="Ouvrir le menu"
    data-menu-toggle
  >
    <span class="ap-menu-label">Menu</span>

    <span class="ap-menu-icon" aria-hidden="true">
      <i></i>
      <i></i>
    </span>
  </button>

  <nav
    class="ap-nav"
    id="site-navigation"
    aria-label="Navigation principale"
    data-site-nav
  >
    <div class="ap-nav-brand" aria-hidden="true">
      <span>Aupositeur</span>
      <i></i>
    </div>

    <div class="ap-nav-links">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="ap-nav-footer">
      <span>Poésie · chanson française</span>
    </div>
  </nav>
</header>

<script>
  import '../scripts/navigation.ts';
</script>
