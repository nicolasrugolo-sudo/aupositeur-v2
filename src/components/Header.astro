---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/ecrits/', label: 'Écrits' },
  { href: '/citations/', label: 'Citations' },
  { href: '/livres/', label: 'Livres' },
  { href: '/musiques/', label: 'Musiques' },
  { href: '/a-propos/', label: 'À propos' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Aupositeur, accueil">
    <span class="wordmark-mark" aria-hidden="true">A</span>
    <span>Aupositeur</span><small>Atelier / 02</small>
  </a>
  <nav aria-label="Navigation principale">
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>

