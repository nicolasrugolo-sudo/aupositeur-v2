<section class="ap-shop-carousel" id="boutique" aria-labelledby="ap-shop-title">
  <h2 id="ap-shop-title">boutique</h2>
  <div class="ap-shop-carousel__grid">
    {products.map(product => <a class="ap-shop-carousel__item" href={product.href} target="_blank" rel="noopener noreferrer" aria-label={`${product.name}, ${product.type} — voir sur Fourthwall`}>
      <div class="ap-shop-carousel__image"><img src={product.image} alt={`${product.name} — ${product.type}`} loading="lazy" decoding="async" /></div>
      <strong>{product.name} <span>({product.type})</span></strong>
    </a>)}
  </div>
  <a class="ap-shop-carousel__all" href="https://aupositeur-shop.fourthwall.com/en-eur" target="_blank" rel="noopener noreferrer">Boutique officielle</a>
</section>
<style>
.ap-shop-carousel{box-sizing:border-box;width:100%;max-width:none;margin:0;padding:clamp(3.5rem,6vw,6rem) 1.25rem;background:#000;color:#fff;text-align:center}
.ap-shop-carousel h2{margin:0 0 clamp(2rem,4vw,3rem);color:#fff;font-family:inherit;font-size:clamp(2rem,3vw,2.7rem);font-weight:750;line-height:1.1;letter-spacing:-.04em}
.ap-shop-carousel__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(.75rem,1.5vw,1.8rem);max-width:1140px;margin:0 auto}
.ap-shop-carousel__item{display:block;min-width:0;color:#fff;text-decoration:none}
.ap-shop-carousel__image{width:100%;aspect-ratio:1/1;background:#333;overflow:hidden;display:grid;place-items:center}
.ap-shop-carousel__image img{display:block;width:100%;height:100%;object-fit:contain}
.ap-shop-carousel__item strong{display:block;margin:.8rem 0 0;font-size:clamp(.75rem,1vw,.95rem);font-weight:700;line-height:1.4}
.ap-shop-carousel__item strong span{font-weight:inherit}
.ap-shop-carousel__item:hover strong,.ap-shop-carousel__item:focus-visible strong{color:#d0653d}
.ap-shop-carousel__all{display:inline-block;margin:clamp(2rem,4vw,3rem) auto 0;padding:.8rem 1.7rem;border-radius:999px;background:#fff;color:#000;text-decoration:none;font-size:.95rem;font-weight:750}
.ap-shop-carousel__all:hover,.ap-shop-carousel__all:focus-visible{background:#d0653d;color:#fff}
@media(max-width:650px){.ap-shop-carousel__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem .8rem}.ap-shop-carousel{padding:3.25rem 1rem}.ap-shop-carousel__item strong{font-size:.8rem}}
</style>
