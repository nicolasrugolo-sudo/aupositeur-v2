<section class="aup-subscribe" aria-label="S'abonner aux nouveautés">
  <h2>Rester au fil des mots</h2>
  <p>Un poème, une chanson, une réflexion… Recevez de temps à autre des nouvelles d’AUPOSITEUR.</p>
  <form id="aup-subscribe-form">
    <label for="aup-subscribe-email">Votre adresse e-mail</label>
    <input id="aup-subscribe-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="vous@exemple.com" />
    <label class="aup-subscribe-consent"><input type="checkbox" name="consent" required /> J'accepte de recevoir les nouveautés d'AUPOSITEUR par e-mail. Je peux me désinscrire à tout moment.</label>
    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
    <button type="submit">M'abonner</button><p role="status" id="aup-subscribe-status"></p>
  </form>
  <p><a href="/confidentialite/">Protection de vos données</a></p>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const api=import.meta.env.PUBLIC_COMMUNITY_API_URL;
  const form=document.querySelector<HTMLFormElement>('#aup-subscribe-form');
  if(form){
    const status=form.querySelector<HTMLElement>('#aup-subscribe-status')!;
    if(!api||!import.meta.env.PUBLIC_TURNSTILE_SITE_KEY){form.hidden=true;status.textContent='Les abonnements seront bientôt disponibles.';}
    form.addEventListener('submit',async e=>{
      e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;
      const fd=new FormData(form);status.textContent='Envoi en cours…';
      try{
        const r=await fetch(api+'/api/subscribe',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:fd.get('email'),consent:fd.get('consent')==='on',turnstile:fd.get('cf-turnstile-response')})});
        const data=await r.json();if(!r.ok)throw Error(data.error||'Inscription impossible');
        status.textContent=data.message;form.reset();(window as any).turnstile?.reset();
      }catch(err){status.textContent=err instanceof Error?err.message:'Inscription impossible';}
      finally{button.disabled=false;}
    });
  }
</script>
<style>
.aup-subscribe{max-width:760px;margin:4rem auto;padding:2.5rem 1rem;border-top:1px solid currentColor;text-align:center}
.aup-subscribe h2{font:normal clamp(1.7rem,3vw,2.5rem) Georgia,serif}
.aup-subscribe p{line-height:1.6}.aup-subscribe form{max-width:540px;margin:1.5rem auto;display:grid;gap:1rem;text-align:left}
.aup-subscribe input[type=email]{width:100%;padding:.85rem;border:1px solid #888;background:transparent;color:inherit}
.aup-subscribe-consent{display:flex;align-items:flex-start;gap:.6rem;font-size:.85rem}
.aup-subscribe button{padding:.85rem 1.2rem;border:0;background:#222;color:white;cursor:pointer}
</style>