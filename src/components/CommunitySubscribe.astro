<section class="aup-subscribe" data-api={import.meta.env.PUBLIC_COMMUNITY_API_URL || "https://community-api.aupositeur.be"} data-turnstile-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAGDeReG_cH6DKjRS"} aria-label="S'abonner aux nouveautés">
  <h2>Newsletter</h2>
  <p>Recevez les nouveautés d’AUPOSITEUR.</p>
  <form id="aup-subscribe-form">
    <label class="aup-subscribe__sr-only" for="aup-subscribe-email">Votre adresse e-mail</label>
    <input id="aup-subscribe-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Votre e-mail" />
    <label class="aup-subscribe-consent"><input type="checkbox" name="consent" required /> J’accepte de recevoir les nouveautés par e-mail. <a href="/confidentialite/">Confidentialité</a></label>
    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAGDeReG_cH6DKjRS"}></div>
    <button type="submit">M'abonner</button><p role="status" id="aup-subscribe-status"></p>
  </form>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const api=document.querySelector<HTMLElement>('.aup-subscribe')?.dataset.api;
  const form=document.querySelector<HTMLFormElement>('#aup-subscribe-form');
  if(form){
    const status=form.querySelector<HTMLElement>('#aup-subscribe-status')!;
    if(!api||!document.querySelector<HTMLElement>('.aup-subscribe')?.dataset.turnstileKey){form.hidden=true;form.insertAdjacentHTML('afterend','<p role="status">Abonnement en préparation : configuration publique Turnstile manquante.</p>');}
    form.addEventListener('submit',async e=>{
      e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;
      const fd=new FormData(form);status.textContent='Envoi en cours…';
      try{
        const r=await fetch(api+'/api/subscribe',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:fd.get('email'),consent:fd.get('consent')==='on',turnstile:fd.get('cf-turnstile-response')})});
        const data=await r.json();if(!r.ok)throw Error(data.error||'Inscription impossible');
        status.textContent=data.message;form.reset();(window as any).turnstile?.reset();
      }catch(err){status.textContent=err instanceof Error?err.message:'Inscription impossible';}
      finally{button.disabled=false;}
    });
  }
</script>
<style>
.aup-subscribe{box-sizing:border-box;width:100%;max-width:none;margin:0;padding:3.5rem 1.25rem 3.75rem;background:#eee;color:#000;text-align:center;border:0}
.aup-subscribe h2{margin:0;font-family:inherit;font-size:clamp(1.9rem,3vw,2.65rem);font-weight:700;line-height:1.15;letter-spacing:-.035em}
.aup-subscribe>p{margin:1rem auto 0;max-width:36rem;font-size:.95rem;line-height:1.5}
.aup-subscribe form{width:min(100%,540px);margin:1.25rem auto 0;display:flex;flex-direction:column;align-items:center;gap:.7rem}
.aup-subscribe__sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.aup-subscribe input[type=email]{box-sizing:border-box;width:100%;height:44px;padding:.65rem 1.25rem;background:#fff;color:#111;border:1px solid #ddd;border-radius:999px;font:inherit;text-align:center}
.aup-subscribe-consent{display:flex;align-items:flex-start;justify-content:center;gap:.45rem;max-width:540px;font-size:.72rem;line-height:1.45;text-align:left;color:#444}
.aup-subscribe-consent input{flex:0 0 auto;margin:.15rem 0 0;accent-color:#111}
.aup-subscribe-consent a{color:inherit;text-decoration:underline;text-underline-offset:2px}
.aup-subscribe .cf-turnstile{align-self:center;max-width:100%;min-height:0}
.aup-subscribe button{align-self:center;min-width:145px;padding:.7rem 1.65rem;border:0;border-radius:999px;background:#000;color:#fff;font:inherit;font-size:.95rem;font-weight:700;cursor:pointer}
.aup-subscribe button:hover,.aup-subscribe button:focus-visible{background:#d0653d}
.aup-subscribe button:disabled{opacity:.6;cursor:wait}
.aup-subscribe #aup-subscribe-status:empty{display:none}
.aup-subscribe #aup-subscribe-status{margin:.25rem 0 0;font-size:.85rem;line-height:1.4}
@media(max-width:600px){.aup-subscribe{padding:3rem 1.25rem}.aup-subscribe>p{font-size:.9rem}.aup-subscribe-consent{font-size:.7rem}}
</style>