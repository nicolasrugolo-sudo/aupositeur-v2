---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoemShareButton from '../../components/PoemShareButton.astro';

export async function getStaticPaths() {
  const poemes = await getCollection('poemes');

  return poemes.map((poeme) => ({
    params: { id: poeme.id },
    props: { poeme }
  }));
}

const { poeme } = Astro.props;
const { Content } = await render(poeme);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialPhoto = poeme.data.socialPhoto || '/images/aupositeur/portraits/aupositeur-01.png';
const description = poeme.data.description || `${poeme.data.title} — un poème d’AUPOSITEUR`;
---

<BaseLayout
  title={`${poeme.data.title} — Aupositeur`}
  description={description}
  ogImage={socialPhoto}
  ogType="article"
>
  <article class="ap-poem">

    <header class="ap-poem__cover">

      <div class="ap-poem__topline">
        <a href="/ecrits/">← Écrits</a>

        <span>
          {poeme.data.year
            ? `${poeme.data.year} / Poésie`
            : 'Aupositeur / Poésie'}
        </span>
      </div>

      <div class="ap-poem__title">
        <p>Un texte</p>
        <h1>{poeme.data.title}</h1>
      </div>

      <p class="ap-poem__invitation">
        Faites défiler<br />
        pour lire
      </p>

      <span class="ap-poem__mark" aria-hidden="true">
        A
      </span>
    </header>

    <section class="ap-poem__reading">

      <aside class="ap-poem__reading-rail" aria-hidden="true">
        <span>Début</span>
        <i></i>
        <span>Fin</span>
      </aside>

      <div class="ap-poem__body">
        {
          poeme.data.draft
            ? <p>Texte original en attente.</p>
            : <Content />
        }
      </div>

    </section>

    <footer class="ap-poem__ending">

      <div class="ap-poem__ending-label">
        <span>Aupositeur</span>
        <span>Bruxelles</span>
      </div>

      <p>
        Laisser quelques secondes<br />
        <em>avant de repartir.</em>
      </p>

      <div class="ap-poem__actions">
        <a href="/ecrits/">
          Découvrir les autres écrits →
        </a>

        <PoemShareButton
          title={poeme.data.title}
          body={poeme.body ?? ''}
          url={canonicalUrl}
          photo={socialPhoto}
          slug={poeme.id}
        />
      </div>

    </footer>

  </article>
</BaseLayout>
