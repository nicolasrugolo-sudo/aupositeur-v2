---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoemShareButton from '../../components/PoemShareButton.astro';

export async function getStaticPaths() {
  const poemes = await getCollection('poemes');

  return poemes.map((poeme) => ({
    params: { id: poeme.id },
    props: { poeme }
  }));
}

const { poeme } = Astro.props;
const { Content } = await render(poeme);

const fallbackPhoto = (slug: string) => {
  let hash = 0;
  for (const ch of slug) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
  const index = (hash % 25) + 1;
  return `/images/aupositeur/portraits/aupositeur-${String(index).padStart(2, '0')}.png`;
};

const stripMarkdown = (value: string) => value
  .replace(/^---[\s\S]*?---\s*/u, '')
  .replace(/<!--([\s\S]*?)-->/g, '')
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/^>\s?/gm, '')
  .replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/__([^_]+)__/g, '$1')
  .replace(/\*([^*]+)\*/g, '$1')
  .replace(/_([^_]+)_/g, '$1')
  .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
  .replace(/<br\s*\/?>/gi, '\n')
  .replace(/<[^>]+>/g, '')
  .replace(/\r/g, '')
  .replace(/\n{3,}/g, '\n\n')
  .trim();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const configuredPhoto = poeme.data.socialPhoto || '/images/aupositeur/portraits/aupositeur-01.png';
const socialPhoto = configuredPhoto === '/images/aupositeur/portraits/aupositeur-01.png'
  ? fallbackPhoto(poeme.id)
  : configuredPhoto;
const plainPoem = stripMarkdown(poeme.body ?? '');
const description = plainPoem
  ? `${poeme.data.title.toUpperCase()} — ${plainPoem}`
  : (poeme.data.description || `${poeme.data.title} — un poème d’AUPOSITEUR`);

// Version the Facebook card URL so Facebook and the raster proxy cannot keep
// serving an older composition after a design correction.
const facebookSvg = `https://www.aupositeur.be/social/facebook/ecrits/${encodeURIComponent(poeme.id)}.svg?v=20260911c`;
const facebookImage = `https://images.weserv.nl/?url=${encodeURIComponent(facebookSvg)}&output=png&w=1200&h=630&fit=contain&we=1`;
---

<BaseLayout
  title={`${poeme.data.title} — Aupositeur`}
  description={description}
  ogImage={facebookImage}
  ogImageWidth="1200"
  ogImageHeight="630"
  ogType="article"
>
  <article class="ap-poem">

    <header class="ap-poem__cover">

      <div class="ap-poem__topline">
        <a href="/ecrits/">← Écrits</a>

        <span>
          {poeme.data.year
            ? `${poeme.data.year} / Poésie`
            : 'Aupositeur / Poésie'}
        </span>
      </div>

      <div class="ap-poem__title">
        <p>Un texte</p>
        <h1>{poeme.data.title}</h1>
      </div>

      <p class="ap-poem__invitation">
        Faites défiler<br />
        pour lire
      </p>

      <span class="ap-poem__mark" aria-hidden="true">
        A
      </span>
    </header>

    <section class="ap-poem__reading">

      <aside class="ap-poem__reading-rail" aria-hidden="true">
        <span>Début</span>
        <i></i>
        <span>Fin</span>
      </aside>

      <div class="ap-poem__body">
        {
          poeme.data.draft
            ? <p>Texte original en attente.</p>
            : <Content />
        }
      </div>

    </section>

    <footer class="ap-poem__ending">

      <div class="ap-poem__ending-label">
        <span>Aupositeur</span>
        <span>Bruxelles</span>
      </div>

      <p>
        Laisser quelques secondes<br />
        <em>avant de repartir.</em>
      </p>

      <div class="ap-poem__actions">
        <a href="/ecrits/">
          Découvrir les autres écrits →
        </a>

        <PoemShareButton
          title={poeme.data.title}
          body={poeme.body ?? ''}
          url={canonicalUrl}
          photo={socialPhoto}
          slug={poeme.id}
        />
      </div>

    </footer>

  </article>
</BaseLayout>
