---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityComments from '../../components/CommunityComments.astro';
import RelatedWorks from '../../components/RelatedWorks.astro';
import PoemShareButton from '../../components/PoemShareButton.astro';

export async function getStaticPaths() {
  const poemes = (await getCollection('poemes')).filter(({ data }) => !data.draft).sort((a,b)=>{const ay=a.data.year??a.data.createdAt?.getFullYear()??0,by=b.data.year??b.data.createdAt?.getFullYear()??0;if(ay!==by)return by-ay;const at=a.data.createdAt?.getTime()??0,bt=b.data.createdAt?.getTime()??0;if(at!==bt)return bt-at;return a.data.title.localeCompare(b.data.title,'fr');});
  return poemes.map((poeme,i)=>({params:{id:poeme.id},props:{poeme,previous:poemes[i-1]?{id:poemes[i-1].id,title:poemes[i-1].data.title}:null,next:poemes[i+1]?{id:poemes[i+1].id,title:poemes[i+1].data.title}:null}}));
}

const { poeme, previous, next } = Astro.props;
const { Content } = await render(poeme);
const taxonomy = await getCollection('categories');
const categories = taxonomy.filter(category => poeme.data.categories.includes(category.id));
const publishedYear = poeme.data.year ?? poeme.data.createdAt?.getFullYear();
const stripMarkdown = (value: string) => value
  .replace(/^---[\s\S]*?---\s*/u, '')
  .replace(/<!--([\s\S]*?)-->/g, '')
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/^>\s?/gm, '')
  .replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/__([^_]+)__/g, '$1')
  .replace(/\*([^*]+)\*/g, '$1')
  .replace(/_([^_]+)_/g, '$1')
  .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
  .replace(/<br\s*\/?>/gi, '\n')
  .replace(/<[^>]+>/g, '')
  .replace(/\r/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialPhoto = poeme.data.socialPhoto || '/images/portait-aupositeur.png';
const plainPoem = stripMarkdown(poeme.body ?? '');
const rawDescription = poeme.data.description || plainPoem || `${poeme.data.title}, un poème d’Aupositeur.`;
const excerpt = rawDescription.length > 145 ? `${rawDescription.slice(0, 142).trimEnd()}…` : rawDescription;
const description = `${poeme.data.title} — ${excerpt}`;
const facebookSvg = `https://www.aupositeur.be/social/facebook/ecrits/${encodeURIComponent(poeme.id)}.svg?v=20260911c`;
const facebookImage = `https://images.weserv.nl/?url=${encodeURIComponent(facebookSvg)}&output=png&w=1200&h=630&fit=contain&we=1`;
---

<BaseLayout
  title={`${poeme.data.title} — Aupositeur`}
  description={description}
  ogImage={facebookImage}
  ogImageWidth="1200"
  ogImageHeight="630"
  ogType="article"
  schemaType="CreativeWork"
>
  <article class="ap-reading">
    <header class="ap-reading__header">
      <a class="ap-reading__back" href="/ecrits/">← Tous les écrits</a>
      <p class="ap-reading__meta">Poésie{publishedYear && <> · <time datetime={String(publishedYear)}>{publishedYear}</time></>}</p>
      <h1>{poeme.data.title}</h1>
      {categories.length > 0 && <ul class="ap-reading__topics" aria-label="Catégories">
        {categories.map(category => <li><a href={`/themes/${category.id}/`}>{category.data.label}</a></li>)}
      </ul>}
    </header>
    <div class="ap-reading__text ap-reading__text--verse ap-poem__body"><Content /></div>
    <footer class="ap-reading__after">
      <nav class="ap-reading__share" aria-label="Partager ce poème">
        <PoemShareButton title={poeme.data.title} body={poeme.body ?? ''} url={canonicalUrl} photo={socialPhoto} slug={poeme.id} />
      </nav>
      <CommunityComments type="ecrits" contentId={poeme.id} />
      <RelatedWorks ids={poeme.data.categories} exclude={`ecrits/${poeme.id}`} />
      {(previous || next) && <nav class="ap-reading__neighbors" aria-label="Autres écrits">
        {previous && <a href={`/ecrits/${previous.id}/`}><span>← Texte précédent</span><strong>{previous.title}</strong></a>}
        {next && <a href={`/ecrits/${next.id}/`}><span>Texte suivant →</span><strong>{next.title}</strong></a>}
      </nav>}
    </footer>
  </article>
</BaseLayout>
