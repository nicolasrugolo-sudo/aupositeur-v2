---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';

export async function getStaticPaths() {
  const poemes = await getCollection('poemes');

  return poemes.map((poeme) => ({
    params: { id: poeme.id },
    props: { poeme }
  }));
}

const { poeme } = Astro.props;
const { Content } = await render(poeme);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// Facebook's link crawler needs a conventional raster image. The generated SVG
// card remains available for the site, but the social preview deliberately uses
// the selected PNG portrait so the image is fetched reliably by Facebook.
const socialPhoto = poeme.data.socialPhoto || '/images/aupositeur/portraits/aupositeur-01.png';
const description = poeme.data.description || `${poeme.data.title} — un poème d’AUPOSITEUR`;
const rawPoem = poeme.body ?? '';
const plainPoem = rawPoem
  .replace(/^---[\s\S]*?---\s*/u, '')
  .replace(/<!--([\s\S]*?)-->/g, '')
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/^>\s?/gm, '')
  .replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/__([^_]+)__/g, '$1')
  .replace(/\*([^*]+)\*/g, '$1')
  .replace(/_([^_]+)_/g, '$1')
  .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
  .replace(/<br\s*\/?>/gi, '\n')
  .replace(/<[^>]+>/g, '')
  .replace(/\r/g, '')
  .replace(/\n{3,}/g, '\n\n')
  .trim();
const shareText = `${poeme.data.title.toUpperCase()}\n\n${plainPoem}`;
---

<BaseLayout
  title={`${poeme.data.title} — Aupositeur`}
  description={description}
  ogImage={socialPhoto}
  ogType="article"
>
  <article class="ap-poem">

    <header class="ap-poem__cover">

      <div class="ap-poem__topline">
        <a href="/ecrits/">← Écrits</a>

        <span>
          {poeme.data.year
            ? `${poeme.data.year} / Poésie`
            : 'Aupositeur / Poésie'}
        </span>
      </div>

      <div class="ap-poem__title">
        <p>Un texte</p>
        <h1>{poeme.data.title}</h1>
      </div>

      <p class="ap-poem__invitation">
        Faites défiler<br />
        pour lire
      </p>

      <span class="ap-poem__mark" aria-hidden="true">
        A
      </span>
    </header>

    <section class="ap-poem__reading">

      <aside class="ap-poem__reading-rail" aria-hidden="true">
        <span>Début</span>
        <i></i>
        <span>Fin</span>
      </aside>

      <div class="ap-poem__body">
        {
          poeme.data.draft
            ? <p>Texte original en attente.</p>
            : <Content />
        }
      </div>

    </section>

    <footer class="ap-poem__ending">

      <div class="ap-poem__ending-label">
        <span>Aupositeur</span>
        <span>Bruxelles</span>
      </div>

      <p>
        Laisser quelques secondes<br />
        <em>avant de repartir.</em>
      </p>

      <div class="ap-poem__actions">
        <a href="/ecrits/">
          Découvrir les autres écrits →
        </a>

        <ShareButton
          title={`${poeme.data.title} — AUPOSITEUR`}
          text={shareText}
          url={canonicalUrl}
          author="AUPOSITEUR"
        />
      </div>

    </footer>

  </article>
</BaseLayout>
