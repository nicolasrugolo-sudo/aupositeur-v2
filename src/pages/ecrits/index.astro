---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeFilter from '../../components/ThemeFilter.astro';
import '../../styles/writings-editorial.css';

const poemes = (await getCollection('poemes'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aYear = a.data.year ?? a.data.createdAt?.getFullYear() ?? 0;
    const bYear = b.data.year ?? b.data.createdAt?.getFullYear() ?? 0;
    if (aYear !== bYear) return bYear - aYear;

    const aDate = a.data.createdAt?.getTime() ?? 0;
    const bDate = b.data.createdAt?.getTime() ?? 0;
    if (aDate !== bDate) return bDate - aDate;

    return a.data.title.localeCompare(b.data.title, 'fr');
  });

const taxonomy = (await getCollection('categories')).filter(x=>x.data.active);
const activeIds = new Set(poemes.flatMap(x=>x.data.categories));
const filters = taxonomy.filter(x=>activeIds.has(x.id)).map(x=>({id:x.id,label:x.data.label}));
---

<BaseLayout
  title="Écrits — Aupositeur"
  description="La bibliothèque de poèmes d’Aupositeur."
>
  <section class="ap-writings ap-writings--editorial ap-catalog">

    <header class="ap-catalog__header ap-writings__intro">
      <h1>Écrits</h1>
      <p class="ap-writings__subtitle">Les mots, au fil des années.</p>
    </header>

    <div class="ap-writings__filters"><ThemeFilter categories={filters} /></div>
    <section class="ap-writings__library" aria-label="Bibliothèque des poèmes">
      {poemes.map((poeme, index) => {
        const year = poeme.data.year ?? poeme.data.createdAt?.getFullYear();
        const previous = poemes[index - 1];
        const previousYear = previous?.data.year ?? previous?.data.createdAt?.getFullYear();
        const categories = taxonomy.filter(category => poeme.data.categories.includes(category.id));
        return (
          <article
            class="ap-writing ap-writings__entry"
            data-theme-item
            data-categories={poeme.data.categories.join(' ')}
            data-year={year ?? ''}
          >
            {year && year !== previousYear && <div class="ap-writings__year" aria-hidden="true">{year}</div>}
            <div class="ap-writings__entry-body">
              <a class="ap-writings__entry-link" href={`/ecrits/${poeme.id}/`}>
                <h2>{poeme.data.title}</h2>
                <span class="ap-writings__entry-arrow" aria-hidden="true">↗</span>
              </a>
              {categories.length > 0 && <p class="ap-writings__topics">{categories.map(category => category.data.label).join(' · ')}</p>}
            </div>
          </article>
        );
      })}
    </section>
    <p class="ap-writings__empty" data-writings-empty hidden>Aucun écrit pour ce thème.</p>
    <script>
      const updateWritingYears = () => {
        const entries = Array.from(document.querySelectorAll<HTMLElement>('.ap-writings__entry'));
        let lastYear = '';
        let visible = 0;
        entries.forEach((entry) => {
          if (entry.hidden) return;
          visible++;
          const year = entry.dataset.year ?? '';
          let label = entry.querySelector<HTMLElement>('.ap-writings__year');
          if (year && year !== lastYear) {
            if (!label) {
              label = document.createElement('div');
              label.className = 'ap-writings__year';
              label.setAttribute('aria-hidden', 'true');
              entry.prepend(label);
            }
            label.textContent = year;
            label.hidden = false;
          } else if (label) label.hidden = true;
          lastYear = year;
        });
        const empty = document.querySelector<HTMLElement>('[data-writings-empty]');
        if (empty) empty.hidden = visible > 0;
      };
      document.addEventListener('click', (event) => {
        if ((event.target as Element).closest('.ap-writings__filters [data-theme]')) queueMicrotask(updateWritingYears);
      });
      document.addEventListener('astro:page-load', updateWritingYears);
      updateWritingYears();
    </script>
  </section>
</BaseLayout>