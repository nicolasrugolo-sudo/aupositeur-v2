---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
const poemes = (await getCollection('poemes')).filter(({ data }) => !data.draft);
const excerpt = (body = '') => body.split(/\r?\n/).map((line) => line.trim()).filter(Boolean).slice(0, 2).join(' ');
---

<BaseLayout title="Écrits — Aupositeur" description="La bibliothèque de poèmes d’Aupositeur.">
  <header class="page-heading writings-heading">
    <p class="eyebrow">Bibliothèque / 01</p>
    <h1>Écr<span>i</span>ts</h1>
    <p>Des textes à lire lentement.<br />Une œuvre, une présence, un espace.</p>
    <div class="heading-counter" aria-hidden="true">001</div>
  </header>
  <section class="poem-gallery" aria-label="Galerie des poèmes">
    {poemes.map((poeme, index) => (
      <article class:list={['poem-tile', `tile-${index % 4}`, { featured: poeme.data.featured }]}>
        <div class="tile-top"><span>{String(index + 1).padStart(2, '0')}</span><span>Poésie</span></div>
        <div class="tile-motif" aria-hidden="true"><i></i><b>{String(index + 1).padStart(2, '0')}</b></div>
        <a class="tile-title" href={`/ecrits/${poeme.id}/`}><h2>{poeme.data.title}</h2></a>
        <p class="tile-excerpt">{excerpt(poeme.body)}</p>
        <div class="tile-actions">
          <a href={`/ecrits/${poeme.id}/`}>Lire le poème ↗</a>
          <ShareButton title={poeme.data.title} text={excerpt(poeme.body)} url={new URL(`/ecrits/${poeme.id}/`, Astro.site).href} compact />
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

