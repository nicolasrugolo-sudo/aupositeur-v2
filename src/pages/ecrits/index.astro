---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const poemes = await getCollection('poemes');
---

<BaseLayout title="Écrits — Aupositeur" description="La bibliothèque de poèmes d’Aupositeur.">
  <header class="page-heading writings-heading">
    <p class="eyebrow">Bibliothèque / 01</p>
    <h1>Écr<span>i</span>ts</h1>
    <p>Des textes à lire lentement.<br />Une œuvre, une présence, un espace.</p>
    <div class="heading-counter" aria-hidden="true">001</div>
  </header>
  <section class="work-list" aria-label="Liste des poèmes">
    {poemes.map((poeme, index) => (
      <a class="work-row" href={`/ecrits/${poeme.id}/`}>
        <span class="work-index">{String(index + 1).padStart(2, '0')}</span>
        <div><h2>{poeme.data.title}</h2><p>{poeme.data.description}</p></div>
        <div class="tags">{poeme.data.themes.map((theme) => <span>{theme}</span>)}</div>
        <span class="arrow" aria-hidden="true">Lire ↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

