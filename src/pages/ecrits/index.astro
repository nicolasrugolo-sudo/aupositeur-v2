---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';

const poemes = (await getCollection('poemes'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aDate = a.data.createdAt?.getTime() ?? 0;
    const bDate = b.data.createdAt?.getTime() ?? 0;

    if (aDate !== bDate) return bDate - aDate;

    const aYear = a.data.year ?? 0;
    const bYear = b.data.year ?? 0;

    if (aYear !== bYear) return bYear - aYear;

    return a.data.title.localeCompare(b.data.title, 'fr');
  });

const excerpt = (body = '') =>
  body
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .slice(0, 2)
    .join(' ');
---

<BaseLayout
  title="Écrits — Aupositeur"
  description="La bibliothèque de poèmes d’Aupositeur."
>
  <section class="ap-writings">

    <header class="ap-writings__hero">
      <div class="ap-writings__rail" aria-hidden="true">
        <span>Bibliothèque</span>
        <span>01</span>
      </div>

      <div class="ap-writings__hero-copy">
        <p class="ap-kicker">Les écrits</p>

        <h1>
          Des mots<br />
          <em>à laisser vivre.</em>
        </h1>

        <p class="ap-writings__intro">
          Des textes à lire lentement.<br />
          Sans mode d’emploi.
        </p>
      </div>

      <div class="ap-writings__count" aria-hidden="true">
        <strong>{String(poemes.length).padStart(2, '0')}</strong>
        <span>textes déposés</span>
      </div>
    </header>

    <section
      class="ap-writings__library"
      aria-label="Bibliothèque des poèmes"
    >
      {poemes.map((poeme, index) => {
        const number = String(index + 1).padStart(2, '0');
        const text = excerpt(poeme.body);

        return (
          <article
            class:list={[
              'ap-writing',
              { 'ap-writing--featured': poeme.data.featured }
            ]}
          >
            <div class="ap-writing__meta">
              <span>{number}</span>
              <span>{poeme.data.year || 'Poésie'}</span>
            </div>

            <a
              class="ap-writing__title"
              href={`/ecrits/${poeme.id}/`}
            >
              <h2>{poeme.data.title}</h2>
              <span aria-hidden="true">↗</span>
            </a>

            {text && (
              <p class="ap-writing__excerpt">
                {text}
              </p>
            )}

            <div class="ap-writing__actions">
              <a href={`/ecrits/${poeme.id}/`}>
                Lire
              </a>

              <ShareButton
                title={poeme.data.title}
                text={text}
                url={new URL(`/ecrits/${poeme.id}/`, Astro.site).href}
                compact
              />
            </div>
          </article>
        );
      })}
    </section>

    <footer class="ap-writings__ending">
      <span>Aupositeur / Écrits</span>

      <p>
        Les textes restent.<br />
        <em>Nous, un peu moins.</em>
      </p>
    </footer>

  </section>
</BaseLayout>