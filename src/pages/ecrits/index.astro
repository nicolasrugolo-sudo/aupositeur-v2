---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeFilter from '../../components/ThemeFilter.astro';
import PoemShareButton from '../../components/PoemShareButton.astro';

const poemes = (await getCollection('poemes'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aYear = a.data.year ?? a.data.createdAt?.getFullYear() ?? 0;
    const bYear = b.data.year ?? b.data.createdAt?.getFullYear() ?? 0;
    if (aYear !== bYear) return bYear - aYear;

    const aDate = a.data.createdAt?.getTime() ?? 0;
    const bDate = b.data.createdAt?.getTime() ?? 0;
    if (aDate !== bDate) return bDate - aDate;

    return a.data.title.localeCompare(b.data.title, 'fr');
  });

const taxonomy = (await getCollection('categories')).filter(x=>x.data.active);
const activeIds = new Set(poemes.flatMap(x=>x.data.categories));
const filters = taxonomy.filter(x=>activeIds.has(x.id)).map(x=>({id:x.id,label:x.data.label}));
const excerpt = (body = '') =>
  body
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .slice(0, 2)
    .join('\n');
---

<BaseLayout
  title="Écrits — Aupositeur"
  description="La bibliothèque de poèmes d’Aupositeur."
>
  <section class="ap-writings ap-catalog">

    <header class="ap-catalog__header">
      
      <h1>Écrits</h1>
      
    </header>

    <ThemeFilter categories={filters} />
    <section
      class="ap-writings__library"
      aria-label="Bibliothèque des poèmes"
    >
      {poemes.map((poeme) => {
        const year = poeme.data.year ?? poeme.data.createdAt?.getFullYear();
        const categories = taxonomy.filter(category => poeme.data.categories.includes(category.id));
        const text = excerpt(poeme.body);
        const poemUrl = new URL(`/ecrits/${poeme.id}/`, Astro.site).href;
        const socialPhoto = poeme.data.socialPhoto || '/images/aupositeur/portraits/aupositeur-01.png';

        return (
          <article data-theme-item data-categories={poeme.data.categories.join(' ')}
            class:list={[
              'ap-writing',
              { 'ap-writing--featured': poeme.data.featured }
            ]}
          >
            <div class="ap-writing__meta">
              {year && <time datetime={String(year)}>{year}</time>}
              {categories.length > 0 && <span>{categories.map(category => category.data.label).join(' · ')}</span>}
            </div>

            <a
              class="ap-writing__title"
              href={`/ecrits/${poeme.id}/`}
            >
              <h2>{poeme.data.title}</h2>
              <span aria-hidden="true">↗</span>
            </a>

            {text && (
              <p class="ap-writing__excerpt">
                {text}
              </p>
            )}

            <div class="ap-writing__actions">

              <PoemShareButton
                title={poeme.data.title}
                body={poeme.body ?? ''}
                url={poemUrl}
                photo={socialPhoto}
                slug={poeme.id}
                compact
              />
            </div>
          </article>
        );
      })}
    </section>

    <footer class="ap-writings__ending">
      <span>Aupositeur / Écrits</span>

      <p>
        Les textes restent.<br />
        <em>Nous, un peu moins.</em>
      </p>
    </footer>

  </section>
</BaseLayout>