---
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../content/pages/about.json';
---
<BaseLayout title={about.seoTitle} description={about.seoDescription}>
  <section class="ap-about"><header class="ap-about__hero">
    <div class="ap-about__meta"><span>{about.sectionLabel}</span><span>{about.sectionNumber}</span></div>
    <div class="ap-about__portrait" aria-hidden="true"><img src={about.portrait} alt="" loading="eager" /></div>
    <div class="ap-about__title"><p class="ap-kicker">{about.kicker}</p><h1>{about.title}<br /><em>{about.titleEmphasis}</em></h1></div>
  </header>
  <section class="ap-about__manifesto"><aside><span>{about.identity}</span><i></i><span>{about.location}</span></aside>
    <div class="ap-about__copy"><p class="ap-about__lead">{about.lead}</p><div class="ap-about__columns">{about.columns.map((text) => <p>{text}</p>)}</div>
      <blockquote>{about.quote}<br /><em>{about.quoteEmphasis}</em></blockquote></div>
  </section>
  <section class="ap-about__principles">{about.principles.map((item) => <article><span>{item.number}</span><h2>{item.title}</h2><p>{item.text}</p></article>)}</section>
  <footer class="ap-about__ending"><div><span>A</span></div><p>{about.ending[0]}<br /><em>{about.ending[1]}</em></p><small>{about.endingCaption}</small></footer>
  </section>
</BaseLayout>
