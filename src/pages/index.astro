---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunitySubscribe from '../components/CommunitySubscribe.astro';
import home from '../content/pages/home.json';
import '../styles/home-sections.css';



const featuredWritings = (await getCollection('poemes'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aTime = a.data.createdAt?.getTime() ?? (a.data.year ? Date.UTC(a.data.year, 0, 1) : 0);
    const bTime = b.data.createdAt?.getTime() ?? (b.data.year ? Date.UTC(b.data.year, 0, 1) : 0);
    return bTime - aTime || a.data.title.localeCompare(b.data.title, 'fr');
  })
  .slice(0, 12);

const featuredCitations = (await getCollection('citations'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => (b.data.createdAt?.getTime() ?? 0) - (a.data.createdAt?.getTime() ?? 0))
  .slice(0, 8);

const featuredMusics = (await getCollection('musiques'))
  .filter(({ data }) => data.featured && !data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const featuredReflections = (await getCollection('reflexions'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.createdAt.getTime() - a.data.createdAt.getTime())
  .slice(0, 8);

const featuredBooks = (await getCollection('livres'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'fr'));
import ShopCarousel from '../components/ShopCarousel.astro';
---
<BaseLayout title="Aupositeur - Site officiel">
  <section class="ap-home-masthead" aria-labelledby="home-title">
    <div class="ap-home-masthead__copy">
      <h1 id="home-title">{home.heroTitle} <em>{home.heroEmphasis}.</em></h1>
      <p>{home.heroIntro.join(' ')}</p>
      <a class="ap-text-link" href={featuredWritings.length ? '#a-lire' : '/ecrits/'}>{home.discoverLabel}<span aria-hidden="true">→</span></a>
    </div>
    <figure class="ap-home-masthead__image">
      <img src={home.portrait} alt="" width="1024" height="1536" fetchpriority="high" />
    </figure>
  </section>

  {home.shopEnabled !== false && <ShopCarousel />}
  {featuredWritings.length > 0 && <section class="ap-home-reading ap-home-reading--portrait" id="a-lire" aria-label="Derniers poèmes">
    <div class="ap-reading-portrait-layout">
      <figure class="ap-reading-portrait-layout__visual">
        <img src="/images/aupositeur_1.jpg" alt="Portrait photographique de l'auteur, regard levé" width="400" height="400" loading="lazy" decoding="async" />
      </figure>
      <div class="ap-reading-portrait-layout__content">
        <div class="ap-reading-portrait-layout__list">
          {featuredWritings.map((writing) => (
            <article class="ap-reading-portrait-layout__item">
              <span class="ap-reading-portrait-layout__year">{writing.data.createdAt ? writing.data.createdAt.toLocaleDateString('fr-BE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : (writing.data.year ?? '')}</span>
              <h3><a href={'/ecrits/' + writing.id + '/'}>{writing.data.title}</a></h3>
            </article>
          ))}
        </div>
        <a class="ap-reading-portrait-layout__all" href="/ecrits/">Tous les écrits <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}

  {featuredReflections.length > 0 && <section class="ap-home-reflection ap-home-reflection--carousel" id="reflexions" aria-label="Réflexions">
    <div class="ap-reflection-carousel" data-reflection-carousel>
      <div class="ap-reflection-carousel__track" tabindex="0" aria-label="Réflexions à faire défiler">
        {featuredReflections.map((reflection) => (
          <article class="ap-reflection-carousel__slide">
            {reflection.data.socialPhoto && <a class="ap-reflection-carousel__image" href={`/reflexions/${reflection.id}/`} aria-label={`Lire : ${reflection.data.title}`}>
              <img src={reflection.data.socialPhoto} alt="" loading="lazy" decoding="async" />
            </a>}
            <div class="ap-reflection-carousel__copy">
              <p class="ap-reflection-carousel__date">{reflection.data.createdAt.toLocaleDateString('fr-BE', {day:'numeric',month:'long',year:'numeric'})}</p>
              <h2><a href={`/reflexions/${reflection.id}/`}>{reflection.data.title}</a></h2>
              <p class="ap-reflection-carousel__excerpt">{reflection.data.description}</p>
              <a class="ap-reflection-carousel__read" href={`/reflexions/${reflection.id}/`}>Lire la réflexion <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      {featuredReflections.length > 1 && <div class="ap-reflection-carousel__controls">
        <button type="button" data-reflection-prev aria-label="Réflexion précédente">←</button>
        <span aria-live="polite"><span data-reflection-current>1</span> / {featuredReflections.length}</span>
        <button type="button" data-reflection-next aria-label="Réflexion suivante">→</button>
      </div>}
    </div>
    <a class="ap-reflection-carousel__all" href="/reflexions/">Toutes les réflexions <span aria-hidden="true">→</span></a>
  </section>}


  {featuredCitations.length > 0 && <section class="ap-home-quote ap-home-quote--carousel" id="citations" aria-label="Citations">
    <div class="ap-home-quote__carousel" data-quote-carousel>
      <div class="ap-home-quote__track" id="ap-quote-track" tabindex="0" aria-label="Citations à faire défiler">
        {featuredCitations.map((citation) => (
          <blockquote class="ap-home-quote__slide">
            <span class="ap-home-quote__mark" aria-hidden="true">“</span>
            <p>{citation.data.text}</p>
            <a class="ap-home-quote__read" href={`/citations/${citation.id}/`}>Lire cette citation</a>
          </blockquote>
        ))}
      </div>
      {featuredCitations.length > 1 && <div class="ap-home-quote__controls" aria-label="Navigation du carrousel">
        <button type="button" class="ap-home-quote__arrow" data-quote-prev aria-label="Citation précédente">←</button>
        <span class="ap-home-quote__count" aria-live="polite"><span data-quote-current>1</span> / {featuredCitations.length}</span>
        <button type="button" class="ap-home-quote__arrow" data-quote-next aria-label="Citation suivante">→</button>
      </div>}
    </div>
    <a class="ap-home-quote__all" href="/citations/">Toutes les citations <span aria-hidden="true">→</span></a>
  </section>}


  {featuredMusics.length > 0 && <section class="ap-home-music ap-home-music--carousel" id="musiques" aria-label="Musiques">
    <div class="ap-music-carousel" data-music-carousel>
      <div class="ap-music-carousel__track" tabindex="0" aria-label="Musiques à faire défiler">
        {featuredMusics.map((music) => (
          <article class="ap-music-carousel__slide">
            <a class="ap-music-carousel__visual" href={`/musique/${music.id}/`} aria-label={`Découvrir : ${music.data.title}`}>
              {music.data.cover ? <img src={music.data.cover} alt="" loading="lazy" decoding="async" /> : <span class="ap-music-carousel__placeholder" aria-hidden="true">AUPOSITEUR</span>}
            </a>
            <div class="ap-music-carousel__details">
              <span>{music.data.kind === 'composition' ? 'Composition' : 'Reprise'}</span>
              <h2><a href={`/musique/${music.id}/`}>{music.data.title}</a></h2>
              <a class="ap-music-carousel__listen" href={`/musique/${music.id}/`}>Écouter <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      {featuredMusics.length > 1 && <div class="ap-music-carousel__controls">
        <button type="button" data-music-prev aria-label="Musique précédente">←</button>
        <span aria-live="polite"><span data-music-current>1</span> / {featuredMusics.length}</span>
        <button type="button" data-music-next aria-label="Musique suivante">→</button>
      </div>}
    </div>
    <a class="ap-music-carousel__all" href="/musique/">Toutes les musiques <span aria-hidden="true">→</span></a>
  </section>}


  {featuredBooks.length > 0 && <section class="ap-home-book ap-home-book--carousel" id="livres" aria-label="Livres">
    <div class="ap-book-carousel" data-book-carousel>
      <div class="ap-book-carousel__track" tabindex="0" aria-label="Livres à faire défiler">
        {featuredBooks.map((book) => (
          <article class="ap-book-carousel__slide">
            <a class="ap-book-carousel__cover" href={`/livres/${book.data.slug}/`} aria-label={`Découvrir : ${book.data.title}`}>
              {book.data.cover ? <img src={book.data.cover} alt={`Couverture de ${book.data.title}`} loading="lazy" decoding="async" /> : <span class="ap-book-carousel__placeholder" aria-hidden="true">AUPOSITEUR</span>}
            </a>
            <div class="ap-book-carousel__copy">
              <p class="ap-book-carousel__meta">{book.data.publisher ? `${book.data.author} · ${book.data.publisher}` : book.data.author}</p>
              <h2><a href={`/livres/${book.data.slug}/`}>{book.data.title}</a></h2>
              <p class="ap-book-carousel__lead">{book.data.lead}</p>
              <a class="ap-book-carousel__read" href={`/livres/${book.data.slug}/`}>Découvrir le livre <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      {featuredBooks.length > 1 && <div class="ap-book-carousel__controls">
        <button type="button" data-book-prev aria-label="Livre précédent">←</button>
        <span aria-live="polite"><span data-book-current>1</span> / {featuredBooks.length}</span>
        <button type="button" data-book-next aria-label="Livre suivant">→</button>
      </div>}
    </div>
    <a class="ap-book-carousel__all" href="/livres/">Tous les livres <span aria-hidden="true">→</span></a>
  </section>}


<CommunitySubscribe />
  <script>import '../scripts/home-carousels';</script>
</BaseLayout>
