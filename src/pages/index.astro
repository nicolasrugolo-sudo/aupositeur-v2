---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';
import '../styles/home-sections.css';

const SHOP_API = 'https://aupositeur-shop-api.nicolas-rugolo.workers.dev';

const automaticMockupUrl = (printFileKey: string | undefined, template: string | undefined) => {
  if (!printFileKey || !template) return undefined;
  const withoutPrefix = printFileKey.replace(/^print-masters\//, '');
  const withoutExt = withoutPrefix.replace(/\.[^.]+$/, '');
  return `${SHOP_API}/media/mockups/${withoutExt}-${template}.webp`;
};

const featured = (await getCollection('poemes'))
  .find(({ data }) => data.featured && !data.draft);
const featuredCitation = (await getCollection('citations'))
  .find(({ data }) => data.featured && !data.draft);
const featuredMusic = (await getCollection('musiques'))
  .find(({ data }) => data.featured && !data.draft);
const featuredBook = (await getCollection('livres'))
  .find(({ data }) => data.featured && !data.draft);
const featuredProducts = (await getCollection('boutique'))
  .filter(({ data }) => data.featured && !data.draft)
  .sort((a, b) => a.data.number.localeCompare(b.data.number, 'fr'))
  .slice(0, 3);

const writingExcerpt = (featured?.body ?? '')
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean)
  .slice(0, 2);

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat('fr-BE', {
    style: 'currency',
    currency,
    minimumFractionDigits: Number.isInteger(price) ? 0 : 2,
  }).format(price);
---
<BaseLayout>
  <section class="ap-home-hero">
    <div class="ap-home-hero__portrait" aria-hidden="true"><img src={home.portrait} alt="" width="1024" height="1536" loading="eager" fetchpriority="high" /></div>
    <div class="ap-home-hero__content">
      <h1>{home.heroTitle}<span>{home.heroEmphasis}<i>.</i></span></h1>
      <span class="ap-rule" aria-hidden="true"></span>
      <p class="ap-home-hero__intro">{home.heroIntro.map((line) => <>{line}<br /></>)}</p>
      <a class="ap-text-link" href="#a-lire">{home.discoverLabel}<span aria-hidden="true">↓</span></a>
    </div>
  </section>

  {featured && <section class="ap-home-reading" id="a-lire" aria-labelledby="ap-reading-title">
    <div class="ap-section-label"><span>{home.readingLabel}</span></div>
    <div class="ap-home-reading__grid"><div class="ap-home-reading__main">
      <h2 id="ap-reading-title">{featured.data.title}</h2>
      <p>{writingExcerpt.map((line) => <>{line}<br /></>)}</p><span class="ap-reading-dots" aria-hidden="true">···</span>
      <a class="ap-text-link" href={'/ecrits/' + featured.id + '/'}>{home.readingLinkLabel}<span aria-hidden="true">→</span></a>
    </div><aside class="ap-home-reading__meta"><span>{home.readingType}</span><b>{featured.data.year}</b></aside></div>
  </section>}

  {featuredCitation && <section class="ap-home-quote" aria-label={home.quoteLabel}>
    <div class="ap-section-label"><span>{home.quoteLabel}</span></div>
    <blockquote><span class="ap-quote-mark" aria-hidden="true">“</span><p>{featuredCitation.data.text}</p><span class="ap-quote-mark ap-quote-mark--end" aria-hidden="true">”</span></blockquote>
    <a class="ap-text-link ap-home-quote__link" href="/citations/">{home.quotesLinkLabel}<span aria-hidden="true">→</span></a>
  </section>}

  {featuredMusic && <section class="ap-home-music" aria-labelledby="ap-music-title"><div class="ap-section-label"><span>{home.musicLabel}</span></div>
    <div class="ap-home-music__body"><div class="ap-home-music__visual" aria-hidden="true"><div class="ap-music-moon"></div><div class="ap-music-tree"></div></div>
      <div class="ap-home-music__copy"><h2 id="ap-music-title">{featuredMusic.data.title}</h2><p>{featuredMusic.data.kind === 'composition' ? 'Composition' : 'Reprise'}</p><a class="ap-text-link" href={`https://www.youtube.com/watch?v=${featuredMusic.data.youtubeId}`}>{home.musicLinkLabel}<span aria-hidden="true">→</span></a></div>
      <a class="ap-home-music__all" href="/musiques/">{home.allMusicLabel}<span aria-hidden="true">→</span></a>
    </div>
  </section>}

  {featuredBook && <section class="ap-home-book" aria-labelledby="ap-home-book-title">
    <div class="ap-section-label"><span>À tenir entre les mains</span></div>
    <div class="ap-home-book__body">
      <a class="ap-home-book__cover" href={`/livres/${featuredBook.data.slug}/`}>
        <img src={featuredBook.data.cover} alt={`Couverture de ${featuredBook.data.title}`} loading="lazy" />
      </a>
      <div class="ap-home-book__copy">
        <p class="ap-home-book__meta">{featuredBook.data.publisher ? `${featuredBook.data.author} · ${featuredBook.data.publisher}` : featuredBook.data.author}</p>
        <h2 id="ap-home-book-title">{featuredBook.data.title}</h2>
        <p class="ap-home-book__lead">{featuredBook.data.lead}</p>
        <div class="ap-home-book__actions">
          <a class="ap-text-link" href={`/livres/${featuredBook.data.slug}/`}>Découvrir le livre<span aria-hidden="true">→</span></a>
          <a class="ap-text-link" href="/livres/">Tous les livres<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>}

  {featuredProducts.length > 0 && <section class="ap-home-shop" aria-labelledby="ap-home-shop-title">
    <div class="ap-section-label"><span>Les mots à (em)porter</span></div>
    <div class="ap-home-shop__heading">
      <h2 id="ap-home-shop-title">Des phrases <em>devenues objets.</em></h2>
      <a class="ap-text-link" href="/boutique/">Toute la boutique<span aria-hidden="true">→</span></a>
    </div>
    <div class="ap-home-shop__grid">
      {featuredProducts.map((product) => {
        const autoMockup = product.data.mockupMode === 'auto'
          ? automaticMockupUrl(product.data.printFileKey, product.data.mockupTemplate)
          : undefined;

        return (
          <article class="ap-home-product">
            <a class="ap-home-product__visual" href={`/boutique/${product.data.slug}/`}>
              {autoMockup ? (
                <div class="ap-home-product__scene">
                  <img src={autoMockup} alt={`${product.data.title}, cadre blanc en situation`} loading="lazy" />
                </div>
              ) : product.data.featuredImage ? (
                <img src={product.data.featuredImage} alt={product.data.title} loading="lazy" />
              ) : (
                <div class="ap-home-product__pending">
                  <span>{product.data.number}</span>
                  <strong>{product.data.title}</strong>
                  <small>Visuel HD à venir</small>
                </div>
              )}
            </a>
            <div class="ap-home-product__meta"><span>{product.data.number}</span><span>{product.data.size}</span></div>
            <h3><a href={`/boutique/${product.data.slug}/`}>{product.data.title}</a></h3>
            <blockquote>« {product.data.quote} »</blockquote>
            <div class="ap-home-product__bottom">
              <strong>{formatPrice(product.data.price, product.data.currency)}</strong>
              <a class="ap-text-link" href={`/boutique/${product.data.slug}/`}>Découvrir<span aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>}
</BaseLayout>