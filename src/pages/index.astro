---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunitySubscribe from '../components/CommunitySubscribe.astro';
import home from '../content/pages/home.json';
import '../styles/home-sections.css';
import '../styles/home-noe-prototype.css';



const featuredWritings = (await getCollection('poemes'))
  .filter(({ data }) => data.featured && !data.draft)
  .slice(0, 3);
const writingExcerpt = (entry: (typeof featuredWritings)[number]) =>
  (entry.body ?? '')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .slice(0, 2);

const featuredCitations = (await getCollection('citations'))
  .filter(({ data }) => data.featured && !data.draft)
  .slice(0, 3);

const featuredMusics = (await getCollection('musiques'))
  .filter(({ data }) => data.featured && !data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const featuredReflection = (await getCollection('reflexions'))
  .filter(({ data }) => data.featured && !data.draft)
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())[0];

const featuredBook = (await getCollection('livres'))
  .find(({ data }) => data.featured && !data.draft);
---
<BaseLayout>
  <section class="ap-home-masthead" aria-labelledby="home-title">
    <div class="ap-home-masthead__copy">
      <h1 id="home-title">{home.heroTitle} <em>{home.heroEmphasis}.</em></h1>
      <p>{home.heroIntro.join(' ')}</p>
      <a class="ap-text-link" href={featuredWritings.length ? '#a-lire' : '/ecrits/'}>{home.discoverLabel}<span aria-hidden="true">→</span></a>
    </div>
    <figure class="ap-home-masthead__image">
      <img src={home.portrait} alt="" width="1024" height="1536" fetchpriority="high" />
    </figure>
  </section>

  {featuredWritings.length > 0 && <section class="ap-home-reading" id="a-lire" aria-labelledby="ap-reading-title">
    <div class="ap-section-label"><span>{home.readingLabel}</span></div>
    <div class:list={['ap-home-reading__list', { 'ap-home-reading__list--single': featuredWritings.length === 1 }]}>
      {featuredWritings.map((writing, index) => (
        <article class="ap-home-reading__card">
          <div class="ap-home-reading__main">
            <h2 id={index === 0 ? 'ap-reading-title' : undefined}>{writing.data.title}</h2>
            <p>{writingExcerpt(writing).map((line) => <>{line}<br /></>)}</p>
            <span class="ap-reading-dots" aria-hidden="true">···</span>
            <a class="ap-text-link" href={'/ecrits/' + writing.id + '/'}>{home.readingLinkLabel}<span aria-hidden="true">→</span></a>
          </div>
          <aside class="ap-home-reading__meta"><span>{home.readingType}</span><b>{writing.data.year}</b></aside>
        </article>
      ))}
    </div>
  </section>}

  {featuredReflection && <section class="ap-home-reflection" aria-labelledby="ap-home-reflection-title">
    <div class="ap-section-label"><span>La réflexion à la une</span></div>
    <div class="ap-home-reflection__body">
      {featuredReflection.data.socialPhoto && <a class="ap-home-reflection__image" href={`/reflexions/${featuredReflection.id}/`} aria-label={`Lire : ${featuredReflection.data.title}`}>
        <img src={featuredReflection.data.socialPhoto} alt="" loading="lazy" />
      </a>}
      <div class="ap-home-reflection__copy">
        <p class="ap-home-reflection__meta">Réflexion · {featuredReflection.data.createdAt.toLocaleDateString('fr-BE', {year:'numeric',month:'long',day:'numeric'})}</p>
        <h2 id="ap-home-reflection-title">{featuredReflection.data.title}</h2>
        <p class="ap-home-reflection__excerpt">{featuredReflection.data.description}</p>
        <a class="ap-text-link" href={`/reflexions/${featuredReflection.id}/`}>Lire la réflexion<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}

  {featuredCitations.length > 0 && <section class="ap-home-quote" aria-label={home.quoteLabel}>
    <div class="ap-section-label"><span>{home.quoteLabel}</span></div>
    <div class:list={['ap-home-quote__list', { 'ap-home-quote__list--single': featuredCitations.length === 1 }]}>
      {featuredCitations.map((citation) => (
        <blockquote><span class="ap-quote-mark" aria-hidden="true">“</span><p>{citation.data.text}</p><span class="ap-quote-mark ap-quote-mark--end" aria-hidden="true">”</span><a class="ap-home-quote__open" href={`/citations/${citation.id}/`}>Lire cette citation ↗</a></blockquote>
      ))}
    </div>
    <a class="ap-text-link ap-home-quote__link" href="/citations/">{home.quotesLinkLabel}<span aria-hidden="true">→</span></a>
  </section>}

  {featuredMusics.length > 0 && <section class="ap-home-music" aria-labelledby="ap-music-title"><div class="ap-section-label"><span>{home.musicLabel}</span></div>
    <div class:list={['ap-home-music__list', { 'ap-home-music__list--single': featuredMusics.length === 1 }]}>
      {featuredMusics.map((music, index) => (
        <article class="ap-home-music__body">
          <div class:list={['ap-home-music__visual', { 'ap-home-music__visual--cover': Boolean(music.data.cover) }]} aria-hidden="true">{music.data.cover ? <img src={music.data.cover} alt="" loading="lazy" /> : <><div class="ap-music-moon"></div><div class="ap-music-tree"></div></>}</div>
          <div class="ap-home-music__copy"><h2 id={index === 0 ? 'ap-music-title' : undefined}>{music.data.title}</h2><p>{music.data.kind === 'composition' ? 'Composition' : 'Reprise'}</p><a class="ap-text-link" href={`/musique/${music.id}/`}>{home.musicLinkLabel}<span aria-hidden="true">→</span></a></div>
        </article>
      ))}
    </div>
    <a class="ap-home-music__all" href="/musique/">{home.allMusicLabel}<span aria-hidden="true">→</span></a>
  </section>}


  {featuredBook && <section class="ap-home-book" aria-labelledby="ap-home-book-title">
    <div class="ap-section-label"><span>À tenir entre les mains</span></div>
    <div class="ap-home-book__body">
      <a class="ap-home-book__cover" href={`/livres/${featuredBook.data.slug}/`}>
        <img src={featuredBook.data.cover} alt={`Couverture de ${featuredBook.data.title}`} loading="lazy" />
      </a>
      <div class="ap-home-book__copy">
        <p class="ap-home-book__meta">{featuredBook.data.publisher ? `${featuredBook.data.author} · ${featuredBook.data.publisher}` : featuredBook.data.author}</p>
        <h2 id="ap-home-book-title">{featuredBook.data.title}</h2>
        <p class="ap-home-book__lead">{featuredBook.data.lead}</p>
        <div class="ap-home-book__actions">
          <a class="ap-text-link" href={`/livres/${featuredBook.data.slug}/`}>Découvrir le livre<span aria-hidden="true">→</span></a>
          <a class="ap-text-link" href="/livres/">Tous les livres<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>}

  {home.shopEnabled !== false && <section class:list={['ap-home-shop-callout', {'ap-home-shop-callout--visual': home.shopVisual}]} aria-labelledby="ap-home-shop-callout-title">
    <div class="ap-section-label"><span>{home.shopLabel || 'La boutique'}</span></div>
    <div class="ap-home-shop-callout__body">
      {home.shopVisual && <div class="ap-home-shop-callout__visual"><img src={home.shopVisual} alt="" loading="lazy" /></div>}
      <div class="ap-home-shop-callout__copy">
        <h2 id="ap-home-shop-callout-title">{home.shopTitle || 'Des mots à garder'} <em>{home.shopEmphasis || 'près de soi.'}</em></h2>
        {home.shopText && <p>{home.shopText}</p>}
        <a class="ap-text-link" href={home.shopUrl || 'https://aupositeur-shop.fourthwall.com/'} target="_blank" rel="noopener">{home.shopLinkLabel || 'Découvrir la boutique'}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}
<CommunitySubscribe />
</BaseLayout>
