---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
const compositions = [
  { id: '2HcbemC-IYY', title: "C’est de l’amour aussi…" },
  { id: 'AABO74MK7bg', title: "Des regards que l’on oublie pas" },
  { id: '4nRT3ief5bk', title: 'Tu fous le camp' },
  { id: 'f9152RNwQhc', title: 'Un soir au Bataclan' },
];
const reprises = [
  { id: 'xDxVKwbVlwY', title: 'Ainsi soit Je' },
  { id: 'KnL64vZuG6g', title: "Mieux qu’ici-bas" },
  { id: '0UA4BQS3Eg4', title: "Une sorte d’Église" },
  { id: 'afsUtPo1Yh8', title: "Ils s’aiment" },
  { id: '77Ma86huILM', title: 'Je pense encore à toi' },
  { id: 'wyQo-l9YXzg', title: 'Peine Maximum' },
  { id: '_5aS5MrEHeY', title: 'Nous dormirons ensemble' },
];
---
<BaseLayout title="Musiques — Aupositeur" description="Compositions et reprises d’Aupositeur.">
  <header class="page-heading music-heading">
    <p class="eyebrow">Écouter / 02</p><h1>Mu<span>si</span>ques</h1>
    <p>Des morceaux nés ici.<br />D’autres traversés par une nouvelle voix.</p>
    <div class="sound-bars" aria-hidden="true">{Array.from({length:28}).map((_,i)=><i style={`--n:${(i*7)%19}`}></i>)}</div>
  </header>
  <section class="record-section compositions-record" id="compositions">
    <header class="record-intro"><span>Face A / 04 œuvres</span><h2>Compo<em>sitions</em></h2><p>Textes et musiques originales.<br />Des histoires mises en fréquence.</p></header>
    <div class="track-grid">{compositions.map((track,index)=><TrackCard track={track} index={index} kind="Composition" />)}</div>
  </section>
  <section class="record-section covers-record" id="reprises">
    <header class="record-intro"><span>Face B / 07 œuvres</span><h2>Re<em>prises</em></h2><p>Des chansons traversées autrement.<br />Une voix, une nouvelle lumière.</p></header>
    <div class="track-grid">{reprises.map((track,index)=><TrackCard track={track} index={index} kind="Reprise" />)}</div>
  </section>
</BaseLayout>

