---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const tracks = await getCollection('musiques');
type MusicEntry = CollectionEntry<'musiques'>;
const published = tracks.filter((track) => !track.data.draft).sort((a,b) => a.data.order - b.data.order);
const featured = published.find((track) => track.data.featured) || published[0];
const compositions = published.filter((track) => track.data.kind === 'composition' && track.id !== featured?.id);
const reprises = published.filter((track) => track.data.kind === 'reprise' && track.id !== featured?.id);
const toTrack = (track: MusicEntry) => ({ title: track.data.title, descriptionCourte: track.data.descriptionCourte, youtubeId: track.data.youtubeId, audioKey: track.data.audioKey, spotifyUrl: track.data.spotifyUrl, cover: track.data.cover });
---
<BaseLayout title="Musiques — Aupositeur" description="Compositions originales et reprises d’Aupositeur.">
<main class="music-v2">
  <header class="hero">
    <h1>MUSIQUES<span>.</span></h1>
    <p>Les mots ont parfois<br />besoin d'une voix.</p>
  </header>

  {featured && <section class="featured" aria-label="À l'écoute">
    <TrackCard track={toTrack(featured)} index={0} kind={featured.data.kind === 'composition' ? 'Composition originale' : 'Reprise'} featured />
  </section>}

  {compositions.length > 0 && <section class="collection" id="compositions">
    <header><h2>COMPOSITIONS<br />ORIGINALES<span>.</span></h2><p>Des mots écrits ici.<br />Puis un jour, de la musique.</p></header>
    <div class="track-list">{compositions.map((track,index) => <TrackCard track={toTrack(track)} index={index} kind="Composition originale" />)}</div>
  </section>}

  {reprises.length > 0 && <section class="collection" id="reprises">
    <header><h2>REPRISES<span>.</span></h2><p>Des chansons que je n'ai pas écrites.<br />Mais qui avaient quelque chose à me dire.</p></header>
    <div class="track-list">{reprises.map((track,index) => <TrackCard track={toTrack(track)} index={index} kind="Reprise" />}</div>
  </section>}

  <footer class="ending"><p>D'autres mots<br />cherchent encore<br />leur musique.</p><span>.</span></footer>
</main>
</BaseLayout>

<style>
.music-v2{--orange:var(--ap-rust-bright,#e46f2b);max-width:1440px;margin:0 auto;padding:clamp(5rem,9vw,9rem) clamp(1.4rem,6vw,7rem) 7rem;color:var(--ap-ivory,#f1ede4)}
.hero{min-height:55vh;display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid rgba(255,255,255,.16)}
.hero h1,.collection h2{margin:0;font-family:var(--serif,Georgia,serif);font-weight:400;letter-spacing:-.045em;line-height:.92;text-wrap:balance}
.hero h1{font-size:clamp(4rem,10.5vw,9.4rem)}
.hero h1 span,.collection h2 span,.ending>span{color:var(--orange);font-family:var(--serif,Georgia,serif);font-weight:400;letter-spacing:0}
.hero p{margin:2.2rem 0 0;font-family:var(--mono,monospace);font-size:clamp(.95rem,1.3vw,1.2rem);line-height:1.55;color:rgba(241,237,228,.67)}
.featured{padding:clamp(5rem,9vw,10rem) 0;border-bottom:1px solid rgba(255,255,255,.16)}
.collection{padding:clamp(6rem,10vw,11rem) 0}
.collection+.collection{border-top:1px solid rgba(255,255,255,.16)}
.collection>header{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(240px,.65fr);gap:3rem;align-items:end;margin-bottom:clamp(3rem,6vw,6rem)}
.collection h2{font-size:clamp(2.7rem,6vw,6rem)}
.collection>header p{margin:0 0 .35rem;font-family:var(--mono,monospace);font-size:clamp(.9rem,1.1vw,1.05rem);line-height:1.6;color:rgba(241,237,228,.62)}
.track-list{border-top:1px solid rgba(255,255,255,.22)}
.ending{min-height:55vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;border-top:1px solid rgba(255,255,255,.16)}
.ending p{margin:0;font-family:var(--serif,Georgia,serif);font-weight:400;font-size:clamp(2.2rem,4.8vw,5rem);line-height:1.08;letter-spacing:-.04em}
.ending>span{font-size:3rem;line-height:1;margin-top:1.4rem}
@media(max-width:760px){.music-v2{padding:4rem 1.25rem 5rem}.hero{min-height:52vh}.hero h1{font-size:clamp(3.4rem,17vw,5.5rem)}.hero p{margin-top:1.7rem}.featured{padding:4.5rem 0}.collection{padding:5.5rem 0}.collection>header{grid-template-columns:1fr;gap:1.5rem;margin-bottom:3rem}.collection h2{font-size:clamp(2.5rem,12.5vw,4.2rem)}.ending{min-height:48vh}.ending p{font-size:clamp(2.15rem,10vw,3.6rem)}}
</style>
