---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/reflexions.css';

export async function getStaticPaths() {
  const entries = (await getCollection('reflexions')).filter(({data}) => !data.draft);
  return entries.map(entry => ({params: {slug: entry.id}, props: {entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = new URL(`/reflexions/${entry.id}/`, Astro.site).href;
const encoded = encodeURIComponent(url);
const shareText = encodeURIComponent(entry.data.title);
---
<BaseLayout title={`${entry.data.title} — Aupositeur`} description={entry.data.description} ogImage={entry.data.socialPhoto} ogType="article" schemaType="Article">
  <article class="ap-reflexions ap-reflexions__article">
    <a class="ap-reflexions__back" href="/reflexions/">← Toutes les réflexions</a>
    <header>
      <p class="ap-kicker">Réflexions · {entry.data.author}</p>
      <h1>{entry.data.title}</h1>
      <p class="ap-reflexions__lead">{entry.data.description}</p>
      <time datetime={entry.data.createdAt.toISOString()}>{entry.data.createdAt.toLocaleDateString('fr-BE',{year:'numeric',month:'long',day:'numeric'})}</time>
    </header>
    {entry.data.socialPhoto && <img class="ap-reflexions__cover" src={entry.data.socialPhoto} alt="" />}
    <div class="ap-reflexions__body"><Content /></div>
    <nav class="ap-reflexions__share" aria-label="Partager cette réflexion">
      <strong>Partager cette réflexion</strong>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encoded}`} target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${encoded}`} target="_blank" rel="noopener noreferrer">X</a>
      <a href={`https://api.whatsapp.com/send?text=${shareText}%20${encoded}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encoded}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <button type="button" data-copy-url={url}>Copier le lien</button>
    </nav>
  </article>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach(button => {
    button.addEventListener('click', async () => {
      const url = button.dataset.copyUrl;
      if (!url) return;
      try { await navigator.clipboard.writeText(url); button.textContent = 'Lien copié'; }
      catch { window.prompt('Copiez ce lien :', url); }
    });
  });
</script>
