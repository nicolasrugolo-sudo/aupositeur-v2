---
import { getCollection, render } from 'astro:content';
import RelatedWorks from '../../components/RelatedWorks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityComments from '../../components/CommunityComments.astro';
import ShareButton from '../../components/ShareButton.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('reflexions')).filter(({data}) => !data.draft);
  return entries.map(entry => ({params: {slug: entry.id}, props: {entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = new URL(`/reflexions/${entry.id}/`, Astro.site).href;
const socialSvg = `https://www.aupositeur.be/social/editorial/reflexions/${encodeURIComponent(entry.id)}.svg?v=20261118-inlinephoto3`;
const shareImage = `https://images.weserv.nl/?url=${encodeURIComponent(socialSvg)}&output=png&w=1200&h=1200&fit=contain&we=1`;
const categoryLabels: Record<string, string> = {
  societe: 'Société & Humanité', economie: 'Économie & Travail',
  philosophie: 'Philosophie & Existence', democratie: 'Démocratie & Libertés',
  avenir: 'Demain & Civilisation',
};
const taxonomy = await getCollection('categories');
for (const item of taxonomy) categoryLabels[item.id] = item.data.label;
const articleCategories = entry.data.categories.length ? entry.data.categories : entry.data.category ? [entry.data.category] : [];
---
<BaseLayout title={`${entry.data.title} — Aupositeur`} description={entry.data.description} ogImage={shareImage} ogImageWidth="1200" ogImageHeight="1200" ogType="article" schemaType="Article">
  <article class="ap-reading">
    <header class="ap-reading__header">
      <a class="ap-reading__back" href="/reflexions/">← Toutes les réflexions</a>
      <p class="ap-reading__meta">{entry.data.author} · <time datetime={entry.data.createdAt.toISOString()}>{entry.data.createdAt.toLocaleDateString('fr-BE',{year:'numeric',month:'long',day:'numeric'})}</time></p>
      <h1>{entry.data.title}</h1>
      <p class="ap-reading__lead">{entry.data.description}</p>
      {articleCategories.length > 0 && <ul class="ap-reading__topics" aria-label="Catégories">
        {articleCategories.map(id => <li>{categoryLabels[id] ?? id}</li>)}
      </ul>}
    </header>
    {entry.data.socialPhoto && <img class="ap-reading__cover" src={entry.data.socialPhoto} alt="" loading="eager" />}
    <div class="ap-reading__text ap-reflexions__body"><Content /></div>
    <footer class="ap-reading__after">
    <div class="ap-reading__share"><ShareButton title={entry.data.title} text={entry.data.title} url={url} imageUrl={`/social/editorial/reflexions/${encodeURIComponent(entry.id)}.svg`} compact /></div>

    <CommunityComments type="reflexions" contentId={entry.id} />
    <RelatedWorks ids={articleCategories} exclude={`reflexions/${entry.id}`} />
    </footer>
  </article>
</BaseLayout>

