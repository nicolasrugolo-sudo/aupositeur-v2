---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeFilter from '../../components/ThemeFilter.astro';
import '../../styles/reflexions.css';

const taxonomy = (await getCollection('categories')).filter(item => item.data.active);
const categoryLabels = Object.fromEntries(taxonomy.map(item => [item.id, item.data.label]));
const articles = (await getCollection('reflexions'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => (b.data.createdAt?.getTime() ?? 0) - (a.data.createdAt?.getTime() ?? 0));
const articleCategories = (article: CollectionEntry<'reflexions'>): string[] => article.data.categories?.length
  ? article.data.categories
  : article.data.category ? [article.data.category] : [];
const activeIds = new Set(articles.flatMap(articleCategories));
const filters = taxonomy.filter(item => activeIds.has(item.id)).map(item => ({ id:item.id, label:item.data.label }));
---
<BaseLayout title="Réflexions — Aupositeur" description="Un regard philosophique et sociétal sur le monde, l'humanité et notre avenir.">
  <section class="ap-reflexions ap-reflexions--library">
    <header class="ap-writings__hero">
      <div class="ap-writings__rail" aria-hidden="true">
        <span>Réflexions</span>
        <span>03</span>
      </div>
      <div class="ap-writings__hero-copy">
        <p class="ap-kicker">Le regard d'Aupositeur</p>
        <h1>Réflexions</h1>
        <p class="ap-writings__intro">Des mots pour ressentir. Des réflexions pour comprendre. Des idées pour imaginer autrement.</p>
      </div>
      <div class="ap-writings__count">
        <strong>{String(articles.length).padStart(2, '0')}</strong>
        <span>réflexions publiées</span>
      </div>
    </header>

    <ThemeFilter categories={filters} label="Filtrer les réflexions par thème" />

    <section class="ap-writings__library" aria-label="Bibliothèque des réflexions">
      {articles.length === 0 && <p class="ap-reflexions__empty">Les premières réflexions arrivent bientôt.</p>}
      {articles.map((article, index) => {
        const categories = articleCategories(article);
        return <article class="ap-writing ap-reflexions__entry" data-theme-item data-categories={categories.join(' ')}>
          <div class="ap-writing__meta">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <time datetime={article.data.createdAt.toISOString()}>{article.data.createdAt.getFullYear()}</time>
          </div>
          <a class="ap-writing__title" href={`/reflexions/${article.id}/`}>
            <h2>{article.data.title}</h2>
            <span aria-hidden="true">↗</span>
          </a>
          <div class="ap-reflexions__entry-detail">
            {article.data.socialPhoto && <img src={article.data.socialPhoto} alt="" loading="lazy" />}
            {categories.length > 0 && <p class="ap-reflexions__entry-categories">{categories.map(id => categoryLabels[id] ?? id).join(' · ')}</p>}
            {article.data.description && <p class="ap-writing__excerpt">{article.data.description}</p>}
          </div>
          <div class="ap-writing__actions">
            <a href={`/reflexions/${article.id}/`}>Lire</a>
          </div>
        </article>;
      })}
    </section>
  </section>
</BaseLayout>
