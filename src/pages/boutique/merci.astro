---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Merci — Aupositeur"
  description="Confirmation de paiement Aupositeur."
>
  <main class="ap-checkout-return">
    <p class="ap-checkout-return__eyebrow">Aupositeur</p>
    <h1>Merci.</h1>
    <p>
      Le paiement test a été accepté par Stripe. Aucune commande n’est encore envoyée à Gelato pendant cette phase de validation.
    </p>
    <a href="/boutique/">Retour à la boutique</a>
  </main>

  <style>
    .ap-checkout-return {
      min-height: 70vh;
      max-width: 760px;
      margin: 0 auto;
      padding: 8rem 1.5rem 5rem;
    }

    .ap-checkout-return__eyebrow {
      margin: 0 0 1rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.78rem;
      opacity: 0.65;
    }

    .ap-checkout-return h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: 0.95;
      font-weight: 400;
    }

    .ap-checkout-return p:not(.ap-checkout-return__eyebrow) {
      max-width: 620px;
      margin: 0 0 2rem;
      line-height: 1.7;
    }

    .ap-checkout-return a {
      display: inline-block;
      border-bottom: 1px solid currentColor;
      text-decoration: none;
      padding-bottom: 0.2rem;
    }
  </style>
</BaseLayout>
