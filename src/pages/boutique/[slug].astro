---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits, cadres } from '../../data/boutique';
import '../../styles/boutique-product.css';

export function getStaticPaths() {
  return produits.map((produit) => ({
    params: { slug: produit.slug },
    props: { produit },
  }));
}

const { produit } = Astro.props;

const isFramedPoster = produit.type === 'affiche-encadree';
const productTypeLabel = isFramedPoster ? 'Affiche encadrée' : produit.type === 't-shirt' ? 'T-shirt' : produit.type;
const cadreInitial = 'noir';
const displayPrice = new Intl.NumberFormat('fr-BE', {
  style: 'currency',
  currency: produit.devise,
}).format(produit.prix);

const gelatoFrameLabels: Record<string, string> = {
  blanc: 'Cadre blanc',
  noir: 'Cadre noir',
  bois: 'Cadre en bois',
  'bois-fonce': 'Cadre en bois foncé',
};

const getFrameVariant = (frameId: string) =>
  produit.variants.find((variant) => variant.label === gelatoFrameLabels[frameId]);

const initialVariant = isFramedPoster ? getFrameVariant(cadreInitial) : produit.variants[0];
const hasAutoMockup = Boolean(produit.autoMockup);
---

<BaseLayout
  title={`${produit.titre} — ${productTypeLabel} — Aupositeur`}
  description={`${produit.citation} ${productTypeLabel} Aupositeur${produit.format ? `, format ${produit.format}` : ''}.`}
>
  <article
    class="ap-product ap-product--shop-v3"
    data-product
    data-product-type={produit.type}
    data-product-slug={produit.slug}
    data-product-title={produit.titre}
    data-product-price={String(produit.prix)}
    data-product-currency={produit.devise}
    data-shop-api="https://aupositeur-shop-api.nicolas-rugolo.workers.dev"
    data-selected-sku={initialVariant?.sku ?? ''}
    data-selected-gelato-product-uid={initialVariant?.gelatoProductUid ?? ''}
    data-gelato-template-id={produit.gelatoTemplateId ?? ''}
  >
    <div class="ap-product__topbar">
      <a href="/boutique/">← Collection</a>
      <span>Aupositeur / Collection 01</span>
    </div>

    <section class="ap-product-v3__hero">
      <div class="ap-product-v3__visual" aria-label={`Visuel produit ${produit.titre}`}>
        {hasAutoMockup ? (
          <div class="ap-product-gallery">
            <figure class="ap-product-gallery__main ap-scene-crop ap-scene-crop--white">
              <img src={produit.autoMockup} alt={`${produit.titre}, cadre blanc en situation`} loading="eager" />
            </figure>
            <div class="ap-product-gallery__thumbs" aria-label="Quatre finitions en situation">
              <div class="ap-scene-crop ap-scene-crop--white"><img src={produit.autoMockup} alt="Cadre blanc" loading="lazy" /></div>
              <div class="ap-scene-crop ap-scene-crop--wood"><img src={produit.autoMockup} alt="Cadre bois naturel" loading="lazy" /></div>
              <div class="ap-scene-crop ap-scene-crop--darkwood"><img src={produit.autoMockup} alt="Cadre bois foncé" loading="lazy" /></div>
              <div class="ap-scene-crop ap-scene-crop--black"><img src={produit.autoMockup} alt="Cadre noir" loading="lazy" /></div>
            </div>
          </div>
        ) : (
          <div class="ap-product-v3__fallback-frame">
            <blockquote>« {produit.citation} »</blockquote>
            <small>Aupositeur</small>
          </div>
        )}
      </div>

      <div class="ap-product-v3__info">
        <p class="ap-product__kicker">{productTypeLabel}</p>
        <h1>{produit.titre}</h1>
        <p class="ap-product-v3__lead">
          Une phrase originale Aupositeur imprimée sur papier premium mat et encadrée à la demande.
        </p>

        <div class="ap-product__price">
          <strong>{displayPrice}</strong>
          <span>TVA selon destination</span>
        </div>

        {isFramedPoster ? (
          <section class="ap-product__frames" aria-labelledby="frame-heading">
            <div class="ap-product__frame-heading">
              <span id="frame-heading">Choisir le cadre à commander</span>
              <strong id="selected-frame-label">Noir</strong>
            </div>

            <div class="ap-product__frame-options">
              {cadres.map((cadre) => {
                const variant = getFrameVariant(cadre.id);

                return (
                  <button
                    type="button"
                    class:list={['ap-product__frame', { 'is-active': cadre.id === cadreInitial }]}
                    data-frame={cadre.id}
                    data-label={cadre.label}
                    data-shop-variant={variant?.sku ?? ''}
                    data-gelato-product-uid={variant?.gelatoProductUid ?? ''}
                    disabled={!variant}
                    aria-pressed={cadre.id === cadreInitial ? 'true' : 'false'}
                  >
                    <span class="ap-product__frame-swatch" aria-hidden="true"></span>
                    <span>{cadre.label}</span>
                  </button>
                );
              })}
            </div>
          </section>
        ) : produit.variants.length > 0 ? (
          <section class="ap-product__frames" aria-labelledby="variant-heading">
            <div class="ap-product__frame-heading">
              <span id="variant-heading">Choisir une variante</span>
            </div>
            <div class="ap-product__frame-options">
              {produit.variants.map((variant, index) => (
                <button
                  type="button"
                  class:list={['ap-product__frame', { 'is-active': index === 0 }]}
                  data-shop-variant={variant.sku}
                  data-gelato-product-uid={variant.gelatoProductUid ?? ''}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span>{variant.label}</span>
                </button>
              ))}
            </div>
          </section>
        ) : null}

        <dl class="ap-product__specs">
          {isFramedPoster ? (
            <>
              <div><dt>Format</dt><dd>{produit.format} cm</dd></div>
              <div><dt>Papier</dt><dd>Premium mat · 200 g/m²</dd></div>
              <div><dt>Cadre</dt><dd>Bois de pin · plexiglas</dd></div>
              <div><dt>Fabrication</dt><dd>À la demande</dd></div>
            </>
          ) : (
            <>
              <div><dt>Produit</dt><dd>{productTypeLabel}</dd></div>
              <div><dt>Format</dt><dd>{produit.format}</dd></div>
              <div><dt>Fabrication</dt><dd>Impression à la demande</dd></div>
            </>
          )}
        </dl>

        <button class="ap-product__buy" type="button" disabled data-shop-action>
          Paiement bientôt disponible
        </button>

        <p class="ap-product__buy-note" data-shop-status>
          Les commandes seront ouvertes prochainement.
        </p>
      </div>
    </section>

    {isFramedPoster && (
      <section class="ap-product-v3__mockup">
        <header>
          <div>
            <span>Mise en situation</span>
            <h2>Quatre cadres.<br /><em>Un même texte.</em></h2>
          </div>
          <p>
            Chaque scène utilise le fichier d’impression HD du produit. Les quatre finitions permettent de comparer immédiatement le rendu dans un intérieur réel.
          </p>
        </header>

        {hasAutoMockup ? (
          <figure class="ap-product-v3__mockup-board">
            <img
              src={produit.autoMockup}
              alt={`${produit.titre} — quatre finitions de cadre en situation`}
              loading="lazy"
            />
            <figcaption>
              <span>Blanc</span>
              <span>Bois naturel</span>
              <span>Bois foncé</span>
              <span>Noir</span>
            </figcaption>
          </figure>
        ) : (
          <div class="ap-product-v3__mockup-pending">
            <span>Visuel automatique en attente</span>
            <strong>Le mockup sera généré à partir du fichier HD envoyé dans l’administration.</strong>
          </div>
        )}
      </section>
    )}

    <footer class="ap-product__ending">
      <span>Aupositeur / Bruxelles</span>
      <p>Création originale.<br /><em>Imprimée à la demande.</em></p>
      <a href="/boutique/">Voir toute la collection →</a>
    </footer>
  </article>

  <script>
    import '../../scripts/boutique-product.ts';
  </script>
</BaseLayout>