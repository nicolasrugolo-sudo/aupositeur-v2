---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits, cadres } from '../../data/boutique';
import '../../styles/boutique-pdp-v4.css';

export function getStaticPaths() {
  return produits.map((produit) => ({
    params: { slug: produit.slug },
    props: { produit },
  }));
}

const { produit } = Astro.props;

const isFramedPoster = produit.type === 'affiche-encadree';
const productTypeLabel = isFramedPoster ? 'Affiche encadrÃƒÂ©e' : produit.type === 't-shirt' ? 'T-shirt' : produit.type;
const cadreInitial = 'noir';
const displayPrice = new Intl.NumberFormat('fr-BE', {
  style: 'currency',
  currency: produit.devise,
}).format(produit.prix);

const gelatoFrameLabels: Record<string, string> = {
  blanc: 'Cadre blanc',
  noir: 'Cadre noir',
  bois: 'Cadre en bois',
  'bois-fonce': 'Cadre en bois foncÃƒÂ©',
};

const getFrameVariant = (frameId: string) =>
  produit.variants.find((variant) => variant.label === gelatoFrameLabels[frameId]);

const initialVariant = isFramedPoster ? getFrameVariant(cadreInitial) : produit.variants[0];

---
<BaseLayout
  title={`${produit.titre} — ${productTypeLabel} — Aupositeur`}
  description={`${produit.citation} — ${productTypeLabel} Aupositeur.`}
>
  <article
    class="ap-pdp-v4"
    data-product
    data-base={`/boutique/affiches/${produit.slug}`}
    data-product-type={produit.type}
    data-product-slug={produit.slug}
    data-product-title={produit.titre}
    data-product-price={String(produit.prix)}
    data-product-currency={produit.devise}
    data-selected-sku={initialVariant?.sku ?? ''}
    data-selected-gelato-product-uid={initialVariant?.gelatoProductUid ?? ''}
    data-gelato-template-id={produit.gelatoTemplateId ?? ''}
    data-shop-api="https://aupositeur-shop-api.nicolas-rugolo.workers.dev"
  >
    <nav class="ap-pdp-v4__nav">
      <a href="/boutique/">← Boutique</a>
      <span>Aupositeur / {produit.numero}</span>
    </nav>

    <section class="ap-pdp-v4__hero">
      <div class="ap-pdp-v4__gallery">

        <figure class="ap-pdp-v4__main">
          <img
            id="product-main-image"
            src={`/boutique/affiches/${produit.slug}/${cadreInitial}/Simple.webp`}
            alt={`${produit.titre} — cadre ${cadreInitial}`}
            loading="eager"
            draggable="false"
          />
        </figure>

        <div class="ap-pdp-v4__thumbs" aria-label="Vues du produit">

          <button
            class="ap-pdp-v4__thumb is-active"
            type="button"
            data-gallery-thumb
            data-file="Simple.webp"
            aria-label="Vue du produit"
            aria-pressed="true"
          >
            <img
              src={`/boutique/affiches/${produit.slug}/${cadreInitial}/Simple.webp`}
              alt=""
            />
          </button>

          <button
            class="ap-pdp-v4__thumb"
            type="button"
            data-gallery-thumb
            data-file="Living-Room-Modern-White-1.webp"
            aria-label="Vue dans un intérieur"
            aria-pressed="false"
          >
            <img
              src={`/boutique/affiches/${produit.slug}/${cadreInitial}/Living-Room-Modern-White-1.webp`}
              alt=""
            />
          </button>

          <button
            class="ap-pdp-v4__thumb"
            type="button"
            data-gallery-thumb
            data-file="Bedroom-Modern-White-2.webp"
            aria-label="Vue dans une chambre"
            aria-pressed="false"
          >
            <img
              src={`/boutique/affiches/${produit.slug}/${cadreInitial}/Bedroom-Modern-White-2.webp`}
              alt=""
            />
          </button>

        </div>
      </div>

      <aside class="ap-pdp-v4__buy">

        <header class="ap-pdp-v4__heading">
          <p>{productTypeLabel}</p>
          <h1>{produit.titre}</h1>
        </header>

        <blockquote class="ap-pdp-v4__quote">
          « {produit.citation} »
        </blockquote>

        <div class="ap-pdp-v4__price">
          <strong>{displayPrice}</strong>
          <span>TVA selon destination</span>
        </div>

        {isFramedPoster && (
          <section class="ap-pdp-v4__choice">

            <div class="ap-pdp-v4__choice-heading">
              <span>Cadre</span>
              <strong id="selected-frame-label">Noir</strong>
            </div>

            <div class="ap-pdp-v4__frames">

              {cadres.map((cadre) => {
                const variant = getFrameVariant(cadre.id);

                return (
                  <button
                    type="button"
                    class:list={[
                      'ap-pdp-v4__frame',
                      `ap-pdp-v4__frame--${cadre.id}`,
                      { 'is-active': cadre.id === cadreInitial },
                    ]}
                    data-frame={cadre.id}
                    data-label={cadre.label}
                    data-shop-variant={variant?.sku ?? ''}
                    data-gelato-product-uid={variant?.gelatoProductUid ?? ''}
                    disabled={!variant}
                    aria-pressed={cadre.id === cadreInitial ? 'true' : 'false'}
                  >
                    <span class="ap-pdp-v4__swatch"></span>
                    <span>{cadre.label}</span>
                  </button>
                );
              })}

            </div>
          </section>
        )}

        <div class="ap-pdp-v4__essentials">
          <div>
            <span>Format</span>
            <strong>{produit.format} cm</strong>
          </div>

          <div>
            <span>Papier</span>
            <strong>Premium mat · 200 g/m²</strong>
          </div>

          <div>
            <span>Fabrication</span>
            <strong>À la demande</strong>
          </div>
        </div>

        <button
          class="ap-pdp-v4__cta"
          type="button"
          disabled
          data-shop-action
        >
          Paiement bientôt disponible
        </button>

        <p class="ap-pdp-v4__status" data-shop-status>
          Les commandes seront ouvertes prochainement.
        </p>

      </aside>
    </section>

    <section class="ap-pdp-v4__editorial">

      <header class="ap-pdp-v4__editorial-heading">
        <span>Dans la pièce</span>

        <h2>
          Les mots prennent<br />
          <em>leur place.</em>
        </h2>
      </header>

      <figure>
        <img
          src={`/boutique/affiches/${produit.slug}/${cadreInitial}/Living-Room-Modern-White-1.webp`}
          alt={`${produit.titre} dans un intérieur`}
          data-context-image
          data-file="Living-Room-Modern-White-1.webp"
          loading="lazy"
        />
      </figure>

    </section>

    <section class="ap-pdp-v4__statement">
      <span>La phrase</span>

      <blockquote>
        « {produit.citation} »
      </blockquote>
    </section>

    <section class="ap-pdp-v4__object">

      <header>
        <span>L’objet</span>
        <h2>Conçu pour rester.</h2>
      </header>

      <dl>
        <div>
          <dt>Format</dt>
          <dd>{produit.format} cm</dd>
        </div>

        <div>
          <dt>Papier</dt>
          <dd>Premium mat · 200 g/m²</dd>
        </div>

        <div>
          <dt>Cadre</dt>
          <dd>Bois · plexiglas</dd>
        </div>

        <div>
          <dt>Production</dt>
          <dd>Impression à la demande</dd>
        </div>
      </dl>

    </section>

    <footer class="ap-pdp-v4__footer">
      <span>Aupositeur / Bruxelles</span>
      <a href="/boutique/">Voir toute la collection →</a>
    </footer>

  </article>

  <script>
    import '../../scripts/boutique-product.ts';

    const root =
      document.querySelector<HTMLElement>('[data-product]');

    const main =
      document.querySelector<HTMLImageElement>('#product-main-image');

    const getFrame = () =>
      document.querySelector<HTMLButtonElement>(
        '[data-frame].is-active'
      )?.dataset.frame || 'noir';

    const getBase = () =>
      root?.dataset.base || '';

    if (root && main) {

      document
        .querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')
        .forEach((button) => {

          button.addEventListener('click', () => {

            const file = button.dataset.file;

            if (!file) return;

            main.src =
              `${getBase()}/${getFrame()}/${file}`;

            document
              .querySelectorAll<HTMLButtonElement>(
                '[data-gallery-thumb]'
              )
              .forEach((item) => {

                const active = item === button;

                item.classList.toggle(
                  'is-active',
                  active
                );

                item.setAttribute(
                  'aria-pressed',
                  String(active)
                );

              });

          });

        });

      document
        .querySelectorAll<HTMLButtonElement>('[data-frame]')
        .forEach((button) => {

          button.addEventListener('click', () => {

            const frame = button.dataset.frame;

            if (!frame) return;

            const activeThumb =
              document.querySelector<HTMLButtonElement>(
                '[data-gallery-thumb].is-active'
              );

            const file =
              activeThumb?.dataset.file ||
              'Simple.webp';

            main.src =
              `${getBase()}/${frame}/${file}`;

            document
              .querySelectorAll<HTMLImageElement>(
                '[data-context-image]'
              )
              .forEach((image) => {

                const contextFile =
                  image.dataset.file;

                if (contextFile) {
                  image.src =
                    `${getBase()}/${frame}/${contextFile}`;
                }

              });

          });

        });

    }
  </script>

</BaseLayout>