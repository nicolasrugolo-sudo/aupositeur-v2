---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits, cadres, vues } from '../../data/boutique';

export function getStaticPaths() {
  return produits.map((produit) => ({
    params: { slug: produit.slug },
    props: { produit },
  }));
}

const { produit } = Astro.props;

const baseImage = `/boutique/affiches/${produit.slug}`;
const cadreInitial = 'noir';
const vuesAmbiance = vues.filter((vue) => vue.file !== 'Simple.webp');
---

<BaseLayout
  title={`${produit.titre} — Affiche encadrée — Aupositeur`}
  description={`${produit.citation} Affiche encadrée Aupositeur, format 30 × 40 cm.`}
>
  <article
    class="ap-product"
    data-product
    data-base={baseImage}
  >

    <div class="ap-product__topbar">
      <a href="/boutique/">← Collection</a>
      <span>Aupositeur / Collection 01</span>
    </div>


    <section class="ap-product__hero">

      <div class="ap-product__art">
        <div class="ap-product__art-stage">
          <img
            id="product-main-image"
            src={`${baseImage}/${cadreInitial}/Simple.webp`}
            alt={`Affiche ${produit.titre}, cadre noir`}
          />
        </div>

        <span class="ap-product__art-caption">
          30 × 40 cm / encadrée
        </span>
      </div>


      <div class="ap-product__info">

        <div class="ap-product__index">
          <span>{produit.numero}</span>
          <span>Collection 01</span>
        </div>

        <p class="ap-product__kicker">
          Affiche encadrée
        </p>

        <h1>{produit.titre}</h1>

        <blockquote>
          « {produit.citation} »
        </blockquote>

        <div class="ap-product__price">
          <strong>{produit.prix} €</strong>
          <span>TVA selon destination</span>
        </div>


        <section
          class="ap-product__frames"
          aria-labelledby="frame-heading"
        >
          <div class="ap-product__frame-heading">
            <span id="frame-heading">Choisir le cadre</span>

            <strong id="selected-frame-label">
              Noir
            </strong>
          </div>

          <div class="ap-product__frame-options">
            {
              cadres.map((cadre) => (
                <button
                  type="button"
                  class:list={[
                    'ap-product__frame',
                    { 'is-active': cadre.id === cadreInitial }
                  ]}
                  data-frame={cadre.id}
                  data-label={cadre.label}
                  aria-pressed={cadre.id === cadreInitial ? 'true' : 'false'}
                >
                  <span
                    class="ap-product__frame-swatch"
                    aria-hidden="true"
                  ></span>

                  <span>{cadre.label}</span>
                </button>
              ))
            }
          </div>
        </section>


        <button
          class="ap-product__buy"
          type="button"
          disabled
        >
          Paiement bientôt disponible
        </button>

        <p class="ap-product__buy-note">
          Les commandes seront ouvertes prochainement.
        </p>


        <dl class="ap-product__specs">

          <div>
            <dt>Papier</dt>
            <dd>Premium mat · 200 g/m²</dd>
          </div>

          <div>
            <dt>Cadre</dt>
            <dd>Bois de pin · plexiglas</dd>
          </div>

          <div>
            <dt>Format</dt>
            <dd>30 × 40 cm</dd>
          </div>

          <div>
            <dt>Accrochage</dt>
            <dd>Kit inclus</dd>
          </div>

        </dl>

      </div>

    </section>


    <section class="ap-product__context">

      <header class="ap-product__context-heading">

        <div>
          <span>Dans l’espace</span>

          <h2>
            Une phrase.<br />
            <em>Quelque part.</em>
          </h2>
        </div>

        <p>
          L’œuvre change peu.<br />
          C’est la pièce autour d’elle qui change tout.
        </p>

      </header>


      <div class="ap-product__context-grid">
        {
          vuesAmbiance.map((vue, index) => (
            <figure
              class:list={[
                'ap-product__context-item',
                `ap-product__context-item--${index + 1}`
              ]}
            >
              <img
                src={`${baseImage}/${cadreInitial}/${vue.file}`}
                data-context-image
                data-file={vue.file}
                alt={`${produit.titre} — ${vue.label}`}
                loading="lazy"
              />

              <figcaption>
                <span>
                  {String(index + 1).padStart(2, '0')}
                </span>

                {vue.label}
              </figcaption>
            </figure>
          ))
        }
      </div>

    </section>


    <section class="ap-product__share">

      <div>
        <span>Partager</span>

        <h2>
          Montrer l’œuvre<br />
          <em>dans un espace.</em>
        </h2>
      </div>


      <div class="ap-product__share-tools">

        <div class="ap-product__share-views">
          {
            vuesAmbiance.map((vue, index) => (
              <button
                type="button"
                class:list={[
                  'ap-product__share-view',
                  { 'is-active': index === 0 }
                ]}
                data-share-view={vue.file}
                data-share-label={vue.label}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {vue.label}
              </button>
            ))
          }
        </div>

        <button
          class="ap-product__share-button"
          id="share-artwork"
          type="button"
          data-title={produit.titre}
          data-quote={produit.citation}
          data-slug={produit.slug}
        >
          <span>Partager</span>
          <span aria-hidden="true">↗</span>
        </button>

        <p
          class="ap-product__share-status"
          id="share-status"
          aria-live="polite"
        ></p>

      </div>

    </section>


    <footer class="ap-product__ending">

      <span>Aupositeur / Bruxelles</span>

      <p>
        Création originale.<br />
        <em>Imprimée à la demande.</em>
      </p>

      <a href="/boutique/">
        Voir toute la collection →
      </a>

    </footer>

  </article>

  <script>
    import '../../scripts/boutique-product.ts';
  </script>

</BaseLayout>