---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits } from '../../data/boutique';
---

<BaseLayout
  title="Boutique — Aupositeur"
  description="Une première collection d’affiches encadrées Aupositeur. Des phrases devenues objets."
>
  <section class="ap-shop">

    <header class="ap-shop__hero">

      <div class="ap-shop__meta">
        <span>Collection / 01</span>
        <span>Bruxelles</span>
      </div>

      <div class="ap-shop__hero-copy">
        <p class="ap-kicker">L’atelier devient matière</p>

        <h1>
          Des mots<br />
          <em>à vivre.</em>
        </h1>

        <p>
          Cinq phrases sorties de la page
          pour prendre place ailleurs.
        </p>
      </div>

      <div class="ap-shop__hero-note">
        <span>05 œuvres</span>
        <strong>30 × 40 cm</strong>
        <small>Affiches encadrées</small>
      </div>

    </header>


    <section
      class="ap-shop__collection"
      aria-label="Collection d’affiches Aupositeur"
    >
      {
        produits.map((produit, index) => (
          <article class="ap-shop-card">

            <a
              class="ap-shop-card__visual"
              href={`/boutique/${produit.slug}/`}
              aria-label={`Découvrir ${produit.titre}`}
            >
              <img
                src={`/boutique/affiches/${produit.slug}/noir/Simple.webp`}
                alt={`Affiche ${produit.titre}, cadre noir`}
                loading={index < 2 ? 'eager' : 'lazy'}
              />

              <span class="ap-shop-card__number">
                {produit.numero}
              </span>
            </a>


            <div class="ap-shop-card__copy">

              <div class="ap-shop-card__meta">
                <span>Affiche encadrée</span>
                <span>30 × 40 cm</span>
              </div>

              <h2>
                <a href={`/boutique/${produit.slug}/`}>
                  {produit.titre}
                </a>
              </h2>

              <blockquote>
                « {produit.citation} »
              </blockquote>

              <div class="ap-shop-card__bottom">
                <strong>{produit.prix} €</strong>

                <a href={`/boutique/${produit.slug}/`}>
                  Découvrir
                  <span aria-hidden="true">↗</span>
                </a>
              </div>

            </div>

          </article>
        ))
      }
    </section>


    <section class="ap-shop__manifesto">

      <span>Objet / texte</span>

      <p>
        Il ne s’agit pas seulement<br />
        de décorer un mur.
        <em>Il s’agit d’y laisser quelque chose.</em>
      </p>

    </section>

  </section>
</BaseLayout>