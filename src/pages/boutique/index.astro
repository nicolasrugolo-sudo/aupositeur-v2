---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits } from '../../data/boutique';

const formatProductType = (type: string) => {
  if (type === 'affiche-encadree') return 'Affiche encadrée';
  return type
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
};
---

<BaseLayout
  title="Boutique — Aupositeur"
  description="Une première collection d’objets Aupositeur. Des phrases devenues matière."
>
  <section class="ap-shop">

    <header class="ap-shop__hero">

      <div class="ap-shop__meta">
        <span>Collection / 01</span>
        <span>Bruxelles</span>
      </div>

      <div class="ap-shop__hero-copy">
        <p class="ap-kicker">L’atelier devient matière</p>

        <h1>
          Des mots<br />
          <em>à vivre.</em>
        </h1>

        <p>
          Des phrases sorties de la page
          pour prendre place ailleurs.
        </p>
      </div>

      <div class="ap-shop__hero-note">
        <span>{String(produits.length).padStart(2, '0')} œuvres</span>
        <strong>Collection 01</strong>
        <small>Objets Aupositeur</small>
      </div>

    </header>

    <section
      class="ap-shop__collection"
      aria-label="Collection Aupositeur"
    >
      {
        produits.map((produit, index) => (
          <article class="ap-shop-card">

            <a
              class="ap-shop-card__visual"
              href={`/boutique/${produit.slug}/`}
              aria-label={`Découvrir ${produit.titre}`}
            >
              <img
                src={produit.image}
                alt={`${produit.titre} — ${formatProductType(produit.type)}`}
                loading={index < 2 ? 'eager' : 'lazy'}
              />

              <span class="ap-shop-card__number">
                {produit.numero}
              </span>
            </a>

            <div class="ap-shop-card__copy">

              <div class="ap-shop-card__meta">
                <span>{formatProductType(produit.type)}</span>
                <span>{produit.format}</span>
              </div>

              <h2>
                <a href={`/boutique/${produit.slug}/`}>
                  {produit.titre}
                </a>
              </h2>

              <blockquote>
                « {produit.citation} »
              </blockquote>

              <div class="ap-shop-card__bottom">
                <strong>{produit.prix} €</strong>

                <a href={`/boutique/${produit.slug}/`}>
                  Découvrir
                  <span aria-hidden="true">↗</span>
                </a>
              </div>

            </div>

          </article>
        ))
      }
    </section>

    <section class="ap-shop__manifesto">

      <span>Objet / texte</span>

      <p>
        Il ne s’agit pas seulement<br />
        de décorer un mur.
        <em>Il s’agit d’y laisser quelque chose.</em>
      </p>

    </section>

  </section>
</BaseLayout>