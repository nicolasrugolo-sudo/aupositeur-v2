---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { produits } from '../../data/boutique';
import '../../styles/boutique-index-v4.css';

const formatProductType = (type: string) => {
  if (type === 'affiche-encadree') return 'Affiche encadrée';

  return type
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
};

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat('fr-BE', {
    style: 'currency',
    currency,
    minimumFractionDigits: Number.isInteger(price) ? 0 : 2,
  }).format(price);

const productVisual = (slug: string) =>
  `/boutique/affiches/${slug}/noir/Simple.webp`;
---

<BaseLayout
  title="Boutique — Aupositeur"
  description="Les mots à (em)porter. Une collection d’objets littéraires Aupositeur."
>
  <main class="ap-shop-v4">

    <header class="ap-shop-v4__intro">

      <div class="ap-shop-v4__eyebrow">
        <span>Collection / 01</span>
        <span>{String(produits.length).padStart(2, '0')} objets</span>
      </div>

      <div class="ap-shop-v4__intro-grid">
        <h1>
          Les mots<br />
          <em>à (em)porter.</em>
        </h1>

        <div class="ap-shop-v4__intro-copy">
          <p>
            Des phrases sorties de la page pour vivre ailleurs.
            Des objets conçus comme une autre façon de garder les mots.
          </p>

          <span>Aupositeur · Bruxelles</span>
        </div>
      </div>

    </header>

    <section
      class="ap-shop-v4__collection"
      aria-label="Collection Aupositeur"
    >
      {
        produits.map((produit, index) => (
          <article
            class:list={[
              'ap-shop-v4__product',
              { 'ap-shop-v4__product--lead': index === 0 },
            ]}
          >
            <a
              class="ap-shop-v4__visual"
              href={`/boutique/${produit.slug}/`}
              aria-label={`Découvrir ${produit.titre}`}
            >
              <img
                src={productVisual(produit.slug)}
                alt={`${produit.titre} — ${formatProductType(produit.type)}`}
                loading={index < 2 ? 'eager' : 'lazy'}
              />

              <span class="ap-shop-v4__number">
                {produit.numero}
              </span>
            </a>

            <div class="ap-shop-v4__info">

              <div class="ap-shop-v4__meta">
                <span>{formatProductType(produit.type)}</span>
                <span>{produit.format} cm</span>
              </div>

              <div class="ap-shop-v4__title-row">
                <h2>
                  <a href={`/boutique/${produit.slug}/`}>
                    {produit.titre}
                  </a>
                </h2>

                <strong>
                  {formatPrice(produit.prix, produit.devise)}
                </strong>
              </div>

              <blockquote>
                « {produit.citation} »
              </blockquote>

              <a
                class="ap-shop-v4__discover"
                href={`/boutique/${produit.slug}/`}
              >
                Voir l’objet
                <span aria-hidden="true">→</span>
              </a>

            </div>
          </article>
        ))
      }
    </section>

    <section class="ap-shop-v4__manifesto">

      <span>Objet / texte</span>

      <p>
        Il ne s’agit pas seulement<br />
        de décorer un mur.
        <em>Il s’agit d’y laisser quelque chose.</em>
      </p>

    </section>

  </main>
</BaseLayout>