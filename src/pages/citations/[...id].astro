---
import { hasCitationVideo } from '../../lib/citation-video.mjs';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import RelatedWorks from '../../components/RelatedWorks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityComments from '../../components/CommunityComments.astro';

export const getStaticPaths = (async () => {
  const shareFamilies = ['classic', 'minimal', 'matter', 'manuscript', 'light'];
  const citations = (await getCollection('citations')).filter(({ data }) => !data.draft).sort((a,b)=>{const aTime=a.data.createdAt?.getTime()??0,bTime=b.data.createdAt?.getTime()??0;if(aTime!==bTime)return bTime-aTime;return a.id.localeCompare(b.id,'fr');});
  return citations.map((citation,index)=>({params:{id:citation.id},props:{citation,shareNumber:String(index+1).padStart(2,'0'),shareFamily:shareFamilies[index%shareFamilies.length],previous:citations[index-1]?{id:citations[index-1].id,text:citations[index-1].data.text}:null,next:citations[index+1]?{id:citations[index+1].id,text:citations[index+1].data.text}:null}}));
}) satisfies GetStaticPaths;
const { citation, shareNumber, shareFamily, previous, next } = Astro.props;
const { Content } = await render(citation);
const automaticVideoUrl = `/videos/citations/${encodeURIComponent(citation.id)}.mp4`;
const hasLocalVideo = hasCitationVideo(citation.id);
const videoPath = citation.data.video || (hasLocalVideo ? automaticVideoUrl : '');
const canonicalUrl = new URL(`/citations/${encodeURIComponent(citation.id)}/`, Astro.site).href;
const normalizedQuote = citation.data.text.replace(/\s+/g, ' ').trim();
const titleExcerpt = normalizedQuote.length > 58 ? `${normalizedQuote.slice(0, 55).trimEnd()}…` : normalizedQuote;
const seoTitle = `${titleExcerpt} — Aupositeur`;
const descriptionQuote = normalizedQuote.length > 125 ? `${normalizedQuote.slice(0, 122).trimEnd()}…` : normalizedQuote;
const seoDescription = `« ${descriptionQuote} » — ${citation.data.author || 'Aupositeur'}`;
const socialImage = `https://www.aupositeur.be/social/previews/citations/${encodeURIComponent(citation.id)}.png`;
---
<BaseLayout title={seoTitle} description={seoDescription} ogType="article" schemaType="CreativeWork" ogImage={socialImage} ogImageWidth="1200" ogImageHeight="630">
  <article class="ap-quote-detail">
    <header class="ap-quote-detail__header">
      <a class="ap-quote-detail__back" href="/citations/"><span aria-hidden="true">←</span> Toutes les citations</a>
      <div class="ap-quote-detail__mark" aria-hidden="true">“</div>
      <h1 class="ap-quote-detail__title">« {citation.data.text} »</h1>
      <div class="ap-quote-detail__meta"><p class="ap-quote-detail__author">— {citation.data.author}</p>{citation.data.context && <p class="ap-quote-detail__context">{citation.data.context}</p>}</div>
    </header>
    {videoPath && <figure class="ap-quote-detail__media"><video src={videoPath} controls playsinline preload="metadata" onerror="this.closest('figure')?.remove()">Votre navigateur ne permet pas de lire cette vidéo.</video></figure>}
    <section class="ap-quote-detail__source"><Content /></section>
    <RelatedWorks ids={citation.data.categories} exclude={`citations/${citation.id}`} />
    <footer class="ap-quote-detail__footer">
      <div class="ap-citation-detail-share"><button type="button" class="ap-share-trigger" data-share-image data-quote={citation.data.text} data-number={shareNumber} data-family={shareFamily} data-slug={citation.id} data-url={canonicalUrl}>Partager la citation <span aria-hidden="true">↗</span></button><span data-share-status aria-live="polite"></span></div>
      {(previous || next) && <nav class="ap-work-neighbors" aria-label="Autres citations">{previous && <a href={`/citations/${previous.id}/`}><span>← Citation précédente</span><strong>{previous.text}</strong></a>}{next && <a href={`/citations/${next.id}/`}><span>Citation suivante →</span><strong>{next.text}</strong></a>}</nav>}
      <a href="/citations/">Toutes les citations →</a>
    </footer>
  </article>
  <script is:inline>
    (()=>{
      // Charte AUPOSITEUR : béton ciré blanc, noir, sans illustrations.
      const W=1080,H=1350,ink='#151515',concrete='#f4f4f1';
      const serif='"Libre Baskerville", Georgia, serif',mono='"Courier Prime", "Courier New", monospace';
      function hashText(text){let h=2166136261;for(let i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
      function wrap(ctx,text,maxWidth){
        const result=[];
        for(const paragraph of String(text).replace(/\r\n?/g,'\n').split('\n')){
          if(!paragraph.trim()){result.push('');continue;}
          let line='';
          for(const word of paragraph.split(/\s+/).filter(Boolean)){
            const candidate=line?line+' '+word:word;
            if(ctx.measureText(candidate).width<=maxWidth){line=candidate;continue;}
            if(line){result.push(line);line='';}
            if(ctx.measureText(word).width<=maxWidth){line=word;continue;}
            // Never crop a long unbroken word: split only when necessary.
            for(const character of Array.from(word)){
              if(line&&ctx.measureText(line+character).width>maxWidth){result.push(line);line='';}
              line+=character;
            }
          }
          if(line)result.push(line);
        }
        return result;
      }
      function fitQuote(ctx,text,maxWidth,maxHeight){
        let low=10,high=96,best=null;
        while(low<=high){
          const size=Math.floor((low+high)/2);
          ctx.font='400 '+size+'px '+serif;
          const lines=wrap(ctx,text,maxWidth),lineHeight=size*1.32;
          if(lines.length*lineHeight<=maxHeight){best={size,lines,lineHeight};low=size+1;}
          else high=size-1;
        }
        return best;
      }
      function drawShareImage(text){
        const canvas=document.createElement('canvas');canvas.width=W;canvas.height=H;
        const ctx=canvas.getContext('2d');if(!ctx)throw new Error('Canvas unavailable');
        ctx.fillStyle=concrete;ctx.fillRect(0,0,W,H);
        // Subtle, deterministic polished-concrete texture; no figurative drawings.
        let seed=hashText(text)||1;
        const random=()=>{seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;return(seed>>>0)/4294967296;};
        for(let i=0;i<4200;i++){
          const x=random()*W,y=random()*H,w=12+random()*170;
          ctx.strokeStyle=random()>.5?'rgba(110,110,110,.022)':'rgba(255,255,255,.13)';
          ctx.lineWidth=.5+random()*2;ctx.beginPath();ctx.moveTo(x,y);
          ctx.lineTo(Math.min(W,x+w),y+(random()-.5)*9);ctx.stroke();
        }
        ctx.textAlign='center';ctx.fillStyle=ink;
        ctx.font='400 26px '+mono;ctx.fillText('C I T A T I O N',W/2,112);
        ctx.fillRect(W/2-58,158,116,2);
        const maxWidth=W-150,maxHeight=860,layout=fitQuote(ctx,text,maxWidth,maxHeight);
        if(!layout)throw new Error('Texte trop long pour rester lisible');
        ctx.font='400 '+layout.size+'px '+serif;
        const top=220+(maxHeight-layout.lines.length*layout.lineHeight)/2;
        layout.lines.forEach((line,i)=>ctx.fillText(line,W/2,top+(i+1)*layout.lineHeight));
        ctx.fillRect(W/2-58,1150,116,2);
        ctx.font='400 35px '+serif;ctx.fillText('A U P O S I T E U R',W/2,1218);
        ctx.font='400 23px '+mono;ctx.fillText('aupositeur.be',W/2,1263);
        return canvas;
      }
      const toBlob=canvas=>new Promise(resolve=>canvas.toBlob(resolve,'image/png',.96));
      document.querySelectorAll('[data-share-image]').forEach(button=>button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector('[data-share-status]');try{if(status)status.textContent='Création de l’image…';await document.fonts?.load('400 84px "Libre Baskerville"');await document.fonts?.load('400 22px "Courier Prime"');await document.fonts?.ready;const text=button.dataset.quote||'',number=button.dataset.number||'01',family=button.dataset.family||'classic',slug=button.dataset.slug||number,pageUrl=button.dataset.url||window.location.href,publication=`« ${text} »\n\n— AUPOSITEUR`,fullText=`${publication}\n\n${pageUrl}`,blob=await toBlob(drawShareImage(text));if(!blob)throw new Error('blob');const file=new File([blob],`aupositeur-citation-${slug}.png`,{type:'image/png'});try{await navigator.clipboard.writeText(fullText);}catch{}if(navigator.share&&(!navigator.canShare||navigator.canShare({files:[file]}))){try{await navigator.share({files:[file],title:'Citation — Aupositeur',text:publication,url:pageUrl});}catch(error){if(error?.name==='AbortError')throw error;await navigator.share({files:[file],title:'Citation — Aupositeur'});}if(status)status.textContent='Image partagée · texte et lien copiés si nécessaire.';}else{const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=file.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);if(status)status.textContent='Image enregistrée · texte et lien copiés.';}}catch(error){if(error?.name==='AbortError'){if(status)status.textContent='';return;}if(status)status.textContent='Partage indisponible.';}setTimeout(()=>{if(status)status.textContent='';},2600);}));
    })();
  </script>
<CommunityComments type="citations" contentId={citation.id} />
</BaseLayout>
