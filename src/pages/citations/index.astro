---
import { getCollection } from 'astro:content';
import ThemeFilter from '../../components/ThemeFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/citations-index.css';

const citations = (await getCollection('citations'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aTime = a.data.createdAt?.getTime() ?? 0;
    const bTime = b.data.createdAt?.getTime() ?? 0;
    if (aTime !== bTime) return bTime - aTime;
    return a.id.localeCompare(b.id, 'fr');
  });
const taxonomy = (await getCollection('categories')).filter(x=>x.data.active);
const activeIds = new Set(citations.flatMap(x=>x.data.categories));
const filters = taxonomy.filter(x=>activeIds.has(x.id)).map(x=>({id:x.id,label:x.data.label}));
const rhythms = ['manifest', 'intimate', 'fracture', 'silence', 'poster'];
const shareFamilies = ['classic', 'minimal', 'matter', 'manuscript', 'light'];
---
<BaseLayout title="Citations — Aupositeur" description="Les phrases brèves d’Aupositeur, à lire et à garder.">
  <section class="ap-citations ap-catalog ap-catalog--quotes" data-theme-scope>
    <header class="ap-catalog__header">
      
      <h1>Citations</h1>
      
    </header>
    <ThemeFilter categories={filters} />
    {citations.length ? (
      <section class="ap-citations__exhibition" aria-label="Citations d’Aupositeur">
        {citations.map((citation, index) => {
          const rhythm = rhythms[index % rhythms.length];
          const family = shareFamilies[index % shareFamilies.length];
          const number = String(index + 1).padStart(2, '0');
          return <article class={`ap-citation ap-citation--${rhythm}`} data-theme-item data-categories={citation.data.categories.join(" ")}>
            <div class="ap-citation__work">
              <blockquote>{citation.data.text}</blockquote>
              <div class="ap-citation__meta"><span>{citation.data.author}</span>{citation.data.context && <span>{citation.data.context}</span>}</div>
              <div class="ap-citation__actions">
                <button type="button" class="ap-citation__share" data-share-image data-quote={citation.data.text} data-number={number} data-family={family} data-slug={citation.id}>Partager en image <span aria-hidden="true">↗</span></button>
                
                <span class="ap-citation__status" data-share-status aria-live="polite"></span>
              </div>
            </div>
          </article>;
        })}
      </section>
    ) : <section class="ap-citations__empty"><span>01 — ∞</span><p>Les premières phrases<br />viendront s’y déposer.</p></section>}
    <footer class="ap-citations__ending" data-reveal><span>Aupositeur / Citations</span><p>Il suffit parfois<br /><em>d’une seule phrase.</em></p></footer>
  </section>

  <script is:inline>
    (() => {
      const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches,items=document.querySelectorAll('[data-reveal]');
      if(reduced||!('IntersectionObserver'in window))items.forEach(item=>item.classList.add('is-visible'));else{const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(!entry.isIntersecting)return;entry.target.classList.add('is-visible');observer.unobserve(entry.target);});},{threshold:.16,rootMargin:'0px 0px -7% 0px'});items.forEach(item=>observer.observe(item));}
      // Charte AUPOSITEUR : béton ciré blanc, noir, sans illustrations.
      const W=1080,H=1350,ink='#151515',concrete='#f4f4f1';
      const serif='"Libre Baskerville", Georgia, serif',mono='"Courier Prime", "Courier New", monospace';
      function hashText(text){let h=2166136261;for(let i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
      function wrap(ctx,text,maxWidth){
        const result=[];
        for(const paragraph of String(text).replace(/\r\n?/g,'\n').split('\n')){
          if(!paragraph.trim()){result.push('');continue;}
          let line='';
          for(const word of paragraph.split(/\s+/).filter(Boolean)){
            const candidate=line?line+' '+word:word;
            if(ctx.measureText(candidate).width<=maxWidth){line=candidate;continue;}
            if(line){result.push(line);line='';}
            if(ctx.measureText(word).width<=maxWidth){line=word;continue;}
            // Never crop a long unbroken word: split only when necessary.
            for(const character of Array.from(word)){
              if(line&&ctx.measureText(line+character).width>maxWidth){result.push(line);line='';}
              line+=character;
            }
          }
          if(line)result.push(line);
        }
        return result;
      }
      function fitQuote(ctx,text,maxWidth,maxHeight){
        let low=10,high=96,best=null;
        while(low<=high){
          const size=Math.floor((low+high)/2);
          ctx.font='400 '+size+'px '+serif;
          const lines=wrap(ctx,text,maxWidth),lineHeight=size*1.32;
          if(lines.length*lineHeight<=maxHeight){best={size,lines,lineHeight};low=size+1;}
          else high=size-1;
        }
        return best;
      }
      function drawShareImage(text){
        const canvas=document.createElement('canvas');canvas.width=W;canvas.height=H;
        const ctx=canvas.getContext('2d');if(!ctx)throw new Error('Canvas unavailable');
        ctx.fillStyle=concrete;ctx.fillRect(0,0,W,H);
        // Subtle, deterministic polished-concrete texture; no figurative drawings.
        let seed=hashText(text)||1;
        const random=()=>{seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;return(seed>>>0)/4294967296;};
        for(let i=0;i<4200;i++){
          const x=random()*W,y=random()*H,w=12+random()*170;
          ctx.strokeStyle=random()>.5?'rgba(110,110,110,.022)':'rgba(255,255,255,.13)';
          ctx.lineWidth=.5+random()*2;ctx.beginPath();ctx.moveTo(x,y);
          ctx.lineTo(Math.min(W,x+w),y+(random()-.5)*9);ctx.stroke();
        }
        ctx.textAlign='center';ctx.fillStyle=ink;
        ctx.font='400 26px '+mono;ctx.fillText('C I T A T I O N',W/2,112);
        ctx.fillRect(W/2-58,158,116,2);
        const maxWidth=W-150,maxHeight=860,layout=fitQuote(ctx,text,maxWidth,maxHeight);
        if(!layout)throw new Error('Texte trop long pour rester lisible');
        ctx.font='400 '+layout.size+'px '+serif;
        const top=220+(maxHeight-layout.lines.length*layout.lineHeight)/2;
        layout.lines.forEach((line,i)=>ctx.fillText(line,W/2,top+(i+1)*layout.lineHeight));
        ctx.fillRect(W/2-58,1150,116,2);
        ctx.font='400 35px '+serif;ctx.fillText('A U P O S I T E U R',W/2,1218);
        ctx.font='400 23px '+mono;ctx.fillText('aupositeur.be',W/2,1263);
        return canvas;
      }
      const toBlob=canvas=>new Promise(resolve=>canvas.toBlob(resolve,'image/png',.96));
      document.querySelectorAll('[data-share-image]').forEach(button=>button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector('[data-share-status]');if(status)status.textContent='Création de l’image…';try{await document.fonts?.load('400 84px "Libre Baskerville"');await document.fonts?.load('400 22px "Courier Prime"');await document.fonts?.ready;const text=button.dataset.quote||'',slug=button.dataset.slug||'citation',blob=await toBlob(drawShareImage(text));if(!blob)throw new Error('blob');const file=new File([blob],`aupositeur-citation-${slug}.png`,{type:'image/png'});if(navigator.share&&(!navigator.canShare||navigator.canShare({files:[file]}))){await navigator.share({files:[file],title:'Citation — Aupositeur'});if(status)status.textContent='Image partagée.';}else{const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=file.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);if(status)status.textContent='Image enregistrée.';}}catch(error){if(error?.name==='AbortError'){if(status)status.textContent='';return;}if(status)status.textContent='Partage indisponible.';}setTimeout(()=>{if(status)status.textContent='';},2200);}));
    })();
  </script>
</BaseLayout>
