---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';

const cover = '/images/aux-cent-maux-sans-visage.png';
---

<BaseLayout
  title="Livres — Aupositeur"
  description="Les livres d’Aupositeur : des mots pour faire lien."
>
  <section class="ap-books">

    <header class="ap-books__hero">

      <div class="ap-books__rail">
        <span>Bibliothèque</span>
        <span>04</span>
      </div>

      <div class="ap-books__hero-copy">
        <p class="ap-kicker">Les livres</p>

        <h1>
          Quand les mots<br />
          <em>deviennent objets.</em>
        </h1>

        <p>
          Des textes qui quittent l’écran et l’atelier
          pour devenir des choses à garder, transmettre
          ou laisser sur une table.
        </p>
      </div>

      <div class="ap-books__hero-number" aria-hidden="true">
        02
      </div>

    </header>



    <!-- Deuxième recueil : présentation sans image, en attendant la couverture définitive. -->
    <section class="ap-book" aria-labelledby="book-de-fil-et-de-chair">
      <div class="ap-book__visual">
        <span class="ap-book__number">Ouvrage / 02</span>
        <a class="ap-book__cover" href="https://livres.bookelis.com/poesie/82719-De-fil-et-de-chair.html" target="_blank" rel="noopener noreferrer" aria-label="Découvrir De fil et de chair sur Bookelis">
          <div style="aspect-ratio: 2 / 3; background: #f6f3ef; color: #222; display: flex; flex-direction: column; justify-content: space-between; padding: 13% 10%; box-sizing: border-box; text-align: left; border: 1px solid #ded9d1;">
            <span style="font-size: clamp(10px, 1.2vw, 16px); letter-spacing: .22em; text-transform: uppercase;">AUPOSITEUR</span>
            <span style="font-family: Georgia, serif; font-size: clamp(22px, 3vw, 44px); line-height: 1.04;">De fil<br />et de<br /><em>chair</em></span>
            <span style="font-size: 11px; letter-spacing: .08em;">Deuxième recueil · 2026</span>
          </div>
        </a>
        <span class="ap-book__edition">34 poèmes illustrés · 76 pages</span>
      </div>
      <div class="ap-book__copy">
        <p class="ap-kicker">Aupositeur · Nouveau recueil · 2026</p>
        <h2 id="book-de-fil-et-de-chair">De fil et<br /><em>de chair.</em></h2>
        <p class="ap-book__lead">Il y a ce que la vie nous donne. Et ce qu’elle nous reprend.</p>
        <p class="ap-book__description">Trente-quatre poèmes illustrés où se croisent l’amour et l’absence, la tendresse et la révolte, les enfants qui grandissent et les liens qui demeurent. Après <em>Aux cent maux sans visage</em>, un deuxième recueil sur ce qui nous relie et ce qui résiste.</p>
        <div class="ap-book__actions">
          <a class="ap-book__primary" href="https://livres.bookelis.com/poesie/82719-De-fil-et-de-chair.html" target="_blank" rel="noopener noreferrer">Découvrir sur Bookelis <span aria-hidden="true">↗</span></a>
          <ShareButton compact title="De fil et de chair — AUPOSITEUR" text="Découvrez le deuxième recueil de poésie illustrée d’AUPOSITEUR." />
        </div>
      </div>
    </section>

    <section
      class="ap-book"
      aria-labelledby="book-aux-cent-maux"
    >

      <div class="ap-book__visual">

        <span class="ap-book__number">
          Ouvrage / 01
        </span>

        <a
          class="ap-book__cover"
          href="/livres/aux-cent-maux-sans-visage/"
        >
          <img
            src={cover}
            alt="Couverture du livre Aux cent maux sans visage"
            loading="lazy"
          />
        </a>

        <span class="ap-book__edition">
          Textes poétiques
        </span>

      </div>


      <div class="ap-book__copy">

        <p class="ap-kicker">
          Aupositeur · Éditions Reflets
        </p>

        <h2 id="book-aux-cent-maux">
          Aux cent maux<br />
          <em>sans visage.</em>
        </h2>

        <p class="ap-book__lead">
          Un livre pour celles et ceux
          qui portent trop sans le dire.
        </p>

        <p class="ap-book__description">
          Un recueil où les mots prennent le temps
          de regarder ce qui reste souvent silencieux.
        </p>

        <div class="ap-book__actions">

          <a
            class="ap-book__primary"
            href="/livres/aux-cent-maux-sans-visage/"
          >
            Découvrir le livre
            <span aria-hidden="true">↗</span>
          </a>

          <a
            href="https://livres.bookelis.com/poesie/59276-Aux-cent-maux-sans-visage.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Acheter sur Bookelis ↗
          </a>

          <ShareButton
            compact
            title="Aux cent maux sans visage"
            text="Découvrez le livre d’Aupositeur, illustré par MaRj."
          />

        </div>

      </div>

    </section>


    <footer class="ap-books__ending">

      <span>Aupositeur / Livres</span>

      <p>
        Certains textes demandent<br />
        <em>à être tenus entre les mains.</em>
      </p>

    </footer>

  </section>
</BaseLayout>