---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';

const cover = 'https://lh3.googleusercontent.com/sitesv/AG8ngQW4cAqoZ4J8lIQXzSp1MHOLE-V3qUyy2JVpfS1J-JEef9GgJnsrObkGTvRqjClyPSvlZ7sTeEMfWpKB4MzTmdkHhYW53pWJfiytDKm5JI9tI4vq9wTa3bzxA2XznBYp1Fo7qWQzEU0flzIEZm8hsVmVqLMLd-__hJ_scf_uT7YcB3k0U5_YkFHld2-Fi27Y_KWq1jUhmp9CRpDerPhCjIz0g29kTIsi177efw=w1280';
---
<BaseLayout title="Livres — Aupositeur" description="Les livres d’Aupositeur : des mots pour faire lien.">
  <main class="books-page">
    <header class="books-heading">
      <p class="eyebrow">Bibliothèque / œuvres publiées</p>
      <h1>Les <em>livres.</em></h1>
      <p>Des recueils où les textes quittent l’atelier pour devenir des objets à garder, transmettre et partager.</p>
      <span aria-hidden="true">01</span>
    </header>

    <section class="book-library" aria-label="Bibliothèque des livres">
      <article class="book-card">
        <div class="book-card-index"><span>Ouvrage / 01</span><i></i><span>Textes poétiques</span></div>
        <a class="book-card-cover" href="/livres/aux-cent-maux-sans-visage/">
          <img src={cover} alt="Présentation du livre Aux cent maux sans visage, illustré par MaRj" />
        </a>
        <div class="book-card-copy">
          <p class="eyebrow">Aupositeur · Éditions Reflets</p>
          <h2><a href="/livres/aux-cent-maux-sans-visage/">Aux cent maux<br /><em>sans visage</em></a></h2>
          <p>Un livre pour celles et ceux qui portent trop sans le dire.</p>
          <div class="book-card-actions">
            <a href="/livres/aux-cent-maux-sans-visage/">Découvrir le livre ↗</a>
            <ShareButton compact title="Aux cent maux sans visage" text="Découvrez le livre d’Aupositeur, illustré par MaRj." />
          </div>
        </div>
        <div class="book-card-orbit" aria-hidden="true"><b>01</b></div>
      </article>
    </section>
  </main>
</BaseLayout>

