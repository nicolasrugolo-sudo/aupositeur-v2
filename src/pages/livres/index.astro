---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';

const books = (await getCollection('livres'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => (a.data.slug === 'de-fil-et-de-chair' ? -1 : b.data.slug === 'de-fil-et-de-chair' ? 1 : a.data.title.localeCompare(b.data.title, 'fr')));
const bookHref = (slug: string) => slug === 'aux-cent-maux-sans-visage'
  ? '/livres/aux-cent-maux-sans-visage/'
  : slug === 'de-fil-et-de-chair'
    ? 'https://livres.bookelis.com/poesie/82719-De-fil-et-de-chair.html'
    : '/livres/';
---
<BaseLayout title="Livres — Aupositeur" description="Les recueils de poésie d’AUPOSITEUR : Aux cent maux sans visage et De fil et de chair.">
  <section class="ap-books">
    <header class="ap-books__hero">
      <div class="ap-books__rail"><span>Bibliothèque</span><span>04</span></div>
      <div class="ap-books__hero-copy">
        <p class="ap-kicker">Les livres</p>
        <h1>Quand les mots<br /><em>deviennent objets.</em></h1>
        <p>Des textes qui quittent l’écran et l’atelier pour devenir des choses à garder, transmettre ou laisser sur une table.</p>
      </div>
      <div class="ap-books__hero-number" aria-hidden="true">{String(books.length).padStart(2, '0')}</div>
    </header>

    {books.map((book, index) => (
      <section class="ap-book" aria-labelledby={`book-${book.data.slug}`}>
        <div class="ap-book__visual">
          <span class="ap-book__number">Ouvrage / {String(index + 1).padStart(2, '0')}</span>
          <a class="ap-book__cover" href={bookHref(book.data.slug)} aria-label={`Découvrir ${book.data.title}`}>
            {book.data.cover
              ? <img src={book.data.cover} alt={`Couverture du livre ${book.data.title}`} loading="lazy" />
              : <div style="aspect-ratio: 2 / 3; background: #f6f3ef; color: #222; display: flex; flex-direction: column; justify-content: space-between; padding: 13% 10%; box-sizing: border-box; text-align: left; border: 1px solid #ded9d1;">
                  <span style="font-size: clamp(10px, 1.2vw, 16px); letter-spacing: .22em; text-transform: uppercase;">AUPOSITEUR</span>
                  <span style="font-family: Georgia, serif; font-size: clamp(22px, 3vw, 44px); line-height: 1.04;">{book.data.title}</span>
                  <span style="font-size: 11px; letter-spacing: .08em;">Recueil de poésie</span>
                </div>
            }
          </a>
          <span class="ap-book__edition">Textes poétiques</span>
        </div>
        <div class="ap-book__copy">
          <p class="ap-kicker">{book.data.author}{book.data.publisher ? ` · ${book.data.publisher}` : ''}</p>
          <h2 id={`book-${book.data.slug}`}>{book.data.title}</h2>
          <p class="ap-book__lead">{book.data.lead}</p>
          <p class="ap-book__description">{book.data.description}</p>
          <div class="ap-book__actions">
            {book.data.slug === 'aux-cent-maux-sans-visage' && <a class="ap-book__primary" href={bookHref(book.data.slug)}>Découvrir le livre <span aria-hidden="true">↗</span></a>}
            <a class={book.data.slug === 'aux-cent-maux-sans-visage' ? '' : 'ap-book__primary'} href={book.data.purchaseUrl} target="_blank" rel="noopener noreferrer">Voir sur Bookelis ↗</a>
            <ShareButton compact title={book.data.title} text={book.data.lead} />
          </div>
        </div>
      </section>
    ))}

    <footer class="ap-books__ending">
      <span>Aupositeur / Livres</span>
      <p>Certains textes demandent<br /><em>à être tenus entre les mains.</em></p>
    </footer>
  </section>
</BaseLayout>
