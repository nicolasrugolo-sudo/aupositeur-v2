---
import "../../styles/studio.css";
const opendaw = "https://opendaw.studio/";
---
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>AUPOSITEUR / STUDIO</title><meta name="theme-color" content="#0b0b0a"/></head>
<body><div class="studio">
<header class="topbar"><div class="brand">AUPOSITEUR <span>/ STUDIO</span></div><div class="crumb">CONTROL ROOM / OVERVIEW</div><div class="sys"><span class="online">PRODUCTION</span><span class="hide-mobile" data-studio-date>PRIVATE WORKSPACE</span><span>NR</span></div></header>
<nav class="rail" aria-label="Studio"><a class="tool active" href="/studio/" title="Control Room">CTRL</a><a class="tool" href="/studio/projets/" title="Projets">PRJ</a><a class="tool" href="/studio/ecrire/" title="Écrire">TXT</a><a class="tool" href={opendaw} target="_blank" rel="noopener" title="openDAW">AUD↗</a><a class="tool" href="/studio/image/" title="Image">IMG</a><a class="tool" href="/studio/video/" title="Vidéo">VID</a><div class="rail-spacer"></div><a class="tool" href="/studio/admin/" title="Administration">ADM</a></nav>
<main class="workspace">
<section class="head"><div><div class="eyebrow">CONTROL ROOM // 001</div><h1>ATELIER DE PRODUCTION</h1></div><div class="headmeta">AUPOSITEUR PRIVATE SYSTEM<br/>SESSION / <span data-api-state>CHECK…</span></div></section>
<div class="quick"><a href="/studio/ecrire/">ÉCRIRE<small>TEXTES · PAROLES · NOTES</small></a><a href={opendaw} target="_blank" rel="noopener">MUSIQUE ↗<small>OPENDAW COMPLET</small></a><a href="/studio/image/">IMAGE<small>VISUELS · FICHIERS CLOUD</small></a><a href="/studio/video/">VIDÉO<small>STORYBOARD · IA · RENDUS</small></a></div>
<div class="notice" data-api-message><strong>Studio V0.3 :</strong> connexion à l’API privée…</div>
<div class="grid">
<section class="panel"><div class="panel-title"><span>PRODUCTION</span><span class="dim">CLOUD WORKSPACE</span></div><div class="overview"><div class="pipeline"><article class="stage done"><span class="num">01</span><h3>ÉCRITURE</h3><p>TEXTES CLOUD</p><div class="bar"><i style="width:100%"></i></div></article><article class="stage work"><span class="num">02</span><h3>AUDIO</h3><p>OPENDAW</p><div class="bar"><i style="width:72%"></i></div></article><article class="stage done"><span class="num">03</span><h3>ASSETS</h3><p>MÉDIATHÈQUE</p><div class="bar"><i style="width:100%"></i></div></article><article class="stage work"><span class="num">04</span><h3>VIDÉO</h3><p>PROVIDERS À BRANCHER</p><div class="bar"><i style="width:20%"></i></div></article></div></div></section>
<aside class="panel"><div class="panel-title"><span>SERVICES</span><span class="dim">LIVE</span></div><div class="services"><div class="service"><span>STUDIO API / ACCESS</span><span class="status" data-api-state>CHECK…</span></div><div class="service"><span>MÉDIATHÈQUE</span><span class="status" data-r2-state>CHECK…</span></div><div class="service"><span>BASE PROJETS</span><span class="status" data-d1-state>CHECK…</span></div><div class="service"><span>OPENDAW</span><span class="status ok">● EXTERNAL</span></div><div class="service"><span>AGNES VIDEO</span><span class="status">CONFIG PENDING</span></div><div class="service"><span>WAN / VIDU</span><span class="status standby">○ STANDBY</span></div></div></aside>
<section class="panel asset-panel"><div class="panel-title"><span>PROJECT ASSETS</span><span class="dim">DONNÉES + MÉDIAS</span></div><div class="assets"><div class="asset"><span>PROJETS</span><b data-count="projects">00</b><span>BASE PROJETS</span></div><div class="asset"><span>ASSETS</span><b data-count="assets">00</b><span>MÉDIATHÈQUE</span></div><div class="asset"><span>TEXTES</span><b>—</b><span>TEXTES CLOUD</span></div><div class="asset"><span>VIDÉO</span><b>—</b><span>À BRANCHER</span></div><div class="asset"><span>AUTH</span><b>✓</b><span>CLOUDFLARE ACCESS</span></div></div></section>
<section class="panel activity"><div class="panel-title"><span>ACTIVITY LOG</span><span class="dim">HISTORIQUE / DERNIERS ÉVÉNEMENTS</span></div><div data-activity-list><div class="empty-state">Chargement de l’activité…</div></div></section>
</div></main>
<footer class="bottom"><span>STUDIO V0.3</span><span>DONNÉES + MÉDIAS</span><span>AUTH <b class="online" data-api-state>CHECK…</b></span><span class="push">AUPOSITEUR // DEMAIN, C'EST AUJOURD'HUI EN MIEUX.</span></footer>
</div><script is:inline src="/studio/studio.js"></script></body></html>