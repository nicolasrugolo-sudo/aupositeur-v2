<StudioLayout title="Projets" code="PROJECTS">
<section class="head"><div><div class="eyebrow">PROJECT MANAGER // 002</div><h1>ŒUVRES & PRODUCTIONS</h1></div><div class="headmeta">BASE PROJETS<br/>V0.5</div></section>
<div class="quick"><button class="studio-button" data-new-project>+ NOUVEAU PROJET</button><a href="/studio/ecrire/">ÉCRIRE<small>ÉDITEUR SYNCHRONISÉ</small></a><a href="https://opendaw.studio/" target="_blank" rel="noopener">OPENDAW ↗<small>PRODUCTION AUDIO COMPLÈTE</small></a><a href="/studio/video/">VIDÉO<small>STORYBOARD & PROVIDERS</small></a></div>
