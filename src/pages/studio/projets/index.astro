<section class="panel"><div class="panel-title"><span>PROJECT INDEX</span><span class="dim"><span data-count="projects">00</span> PROJETS</span></div><div class="project-list" data-project-list></div></section><section class="panel trash-panel"><div class="panel-title"><span>CORBEILLE</span><span class="dim"><span data-count="trash">00</span> PROJETS</span></div><div class="trash-list" data-trash-list><div class="empty-state">Chargement…</div></div></section>
