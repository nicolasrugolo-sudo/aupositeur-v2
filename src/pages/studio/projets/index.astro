---
import StudioLayout from "../../../layouts/StudioLayout.astro";
const projects=[["Putain de vie","CHANSON","AUDIO 72%","VIDÉO 44%"],["À côté de la plaque","CHANSON","MASTER READY","CLIP READY"]];
---
<StudioLayout title="Projets" code="PROJECTS"><section class="head"><div><div class="eyebrow">PROJECT MANAGER // 002</div><h1>ŒUVRES & PRODUCTIONS</h1></div><div class="headmeta">02 PROJETS<br/>01 EN PRODUCTION</div></section><div class="quick"><a href="#">+ NOUVEAU PROJET<small>CHANSON · POÈME · TEXTE · LIBRE</small></a><a href="/studio/ecrire/">ÉCRIRE<small>OUVRIR L'ÉDITEUR</small></a><a href="https://opendaw.studio/" target="_blank">OPENDAW ↗<small>PRODUCTION AUDIO</small></a><a href="/studio/video/">VIDÉO<small>GÉNÉRATIONS & MONTAGE</small></a></div><div class="grid">{projects.map((p,i)=><section class="panel"><div class="panel-title"><span>{String(i+1).padStart(2,"0")} / {p[0].toUpperCase()}</span><span class="dim">{p[1]}</span></div><div class="overview"><div class="pipeline"><article class="stage done"><span class="num">TXT</span><h3>ÉCRITURE</h3><p>READY</p></article><article class="stage work"><span class="num">AUD</span><h3>AUDIO</h3><p>{p[2]}</p></article><article class="stage done"><span class="num">IMG</span><h3>IMAGE</h3><p>READY</p></article><article class="stage work"><span class="num">VID</span><h3>VIDÉO</h3><p>{p[3]}</p></article></div></div></section>)}</div></StudioLayout>