<StudioLayout title="Image" code="IMAGE">
<section class="head"><div><div class="eyebrow">VISUAL LAB // 004</div><h1>IMAGE & ASSETS</h1></div><div class="headmeta">ASSET REGISTER<br/>R2 À BRANCHER</div></section>
