---
import StudioLayout from "../../../layouts/StudioLayout.astro";
const shots=["Taxi sous la pluie","Appartement vide","La porte","Rue","Fenêtre","Départ","Nuit","Silence"];
---
<StudioLayout title="Vidéo" code="VIDEO"><section class="head"><div><div class="eyebrow">VIDEO LAB // 005</div><h1>GÉNÉRATION & STORYBOARD</h1></div><div class="headmeta">PUTAIN DE VIE · 16:9<br/>7 / 16 PLANS</div></section><div class="grid"><section class="panel"><div class="panel-title"><span>STORYBOARD</span><span class="dim">TIMELINE</span></div><div class="shot-grid">{shots.map((s,i)=><article class="shot"><span>{String(i+1).padStart(2,"0")}</span><div class="shot-preview">{i<3?"GENERATED":"STORYBOARD"}</div><b>{s}</b><small>{i<3?"AGNES · READY":"QUEUE · WAITING"}</small></article>)}</div></section><aside class="panel"><div class="panel-title"><span>GENERATOR</span><span class="dim">PROVIDER ROUTER</span></div><div class="services"><div class="service"><span>AGNES</span><span class="status ok">● PRIMARY</span></div><div class="service"><span>WAN</span><span class="status standby">○ DISABLED</span></div><div class="service"><span>VIDU</span><span class="status standby">○ DISABLED</span></div><div class="service"><span>PAID FALLBACK</span><span>APPROVAL REQUIRED</span></div></div><div class="overview"><button class="studio-button">+ NOUVELLE GÉNÉRATION</button></div></aside></div></StudioLayout>