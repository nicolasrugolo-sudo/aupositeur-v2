{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aupositeur-studio-api",
  "main": "./index.js",
  "compatibility_date": "2026-09-22",
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "STUDIO_ASSETS", "bucket_name": "aupositeur-media-assets" }
  ],
  "d1_databases": [
    { "binding": "STUDIO_DB", "database_name": "aupositeur-studio", "database_id": "76e62a13-01af-4ed1-add9-10520600eceb" }
  ]
}