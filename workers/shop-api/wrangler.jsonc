{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aupositeur-shop-api",
  "main": "./market-entry.js",
  "compatibility_date": "2026-09-04",
  "r2_buckets": [
    {
      "binding": "SHOP_ASSETS",
      "bucket_name": "aupositeur-shop-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FULFILLMENT_LOCKS",
        "class_name": "FulfillmentLock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "fulfillment-lock-v1",
      "new_sqlite_classes": [
        "FulfillmentLock"
      ]
    }
  ]
}
