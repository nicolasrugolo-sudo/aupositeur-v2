{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aupositeur-shop-api",
  "main": "./studio-entry.js",
  "compatibility_date": "2026-09-04",
  "keep_vars": true,
  "r2_buckets": [{"binding":"SHOP_ASSETS","bucket_name":"aupositeur-shop-assets"}],
  "images": {"binding":"IMAGES"},
  "durable_objects": {"bindings":[{"name":"FULFILLMENT_LOCKS","class_name":"FulfillmentLock"}]}
}
