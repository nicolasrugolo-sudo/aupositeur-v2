{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aupositeur-community-api",
  "main": "./index.js",
  "compatibility_date": "2026-11-16",
  "vars": {
    "PUBLIC_ORIGIN": "https://www.aupositeur.be"
  },
  "d1_databases": [
    {"binding":"COMMUNITY_DB","database_name":"aupositeur-community","database_id":"REPLACE_WITH_CLOUDFLARE_D1_ID"}
  ],
  "triggers":{"crons":["*/5 * * * *"]}
}
