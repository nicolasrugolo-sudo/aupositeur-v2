{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aupositeur-v2",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin/*"
    ]
  },
  "main": "./workers/site-gateway/index.js",
  "services": [
    {
      "binding": "COMMUNITY_API",
      "service": "aupositeur-community-api"
    }
  ]
}
