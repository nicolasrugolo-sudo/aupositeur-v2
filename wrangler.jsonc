{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aupositeur-v2",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./workers/site-gateway/index.js",
  "services": [
    { "binding": "STUDIO_AUDIO", "service": "aupositeur-media-api" },
    { "binding": "STUDIO_INSIGHTS", "service": "aupositeur-google-insights" },
    {
      "binding": "COMMUNITY_API",
      "service": "aupositeur-community-api"
    }
  ]
}
